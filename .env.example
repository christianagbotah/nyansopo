# Local environment — see scripts/pg/README.md (embedded PostgreSQL 17 on 127.0.0.1:5433)
# Start the server with: bash scripts/pg/start-postgres.sh
DATABASE_URL=postgresql://nyansapo@127.0.0.1:5433/nyansapo?schema=public

# ── SMS gateways (optional — leave unset for SIMULATED demo mode) ──
# Keys are read from the server environment at send time; the school's
# provider choice (SMS Centre → Settings) decides which one is used.
# SMS_ARKESEL_API_KEY=
# SMS_TERMII_API_KEY=
# Base-URL overrides (integration testing against a mock gateway):
# SMS_ARKESEL_BASE_URL=
# SMS_TERMII_BASE_URL=
