# Local environment — see scripts/pg/README.md (embedded PostgreSQL 17 on 127.0.0.1:5433)
# Start the server with: bash scripts/pg/start-postgres.sh
DATABASE_URL=postgresql://nyansapo@127.0.0.1:5433/nyansapo?schema=public

# ── SMS gateways (optional — leave unset for SIMULATED demo mode) ──
# Keys are read from the server environment at send time; the school's
# provider choice (SMS Centre → Settings) decides which one is used.
# SMS_ARKESEL_API_KEY=
# SMS_TERMII_API_KEY=
# Base-URL overrides (integration testing against a mock gateway):
# SMS_ARKESEL_BASE_URL=
# SMS_TERMII_BASE_URL=

# ── Payment gateways (optional — leave ALL unset for SIMULATED sandbox mode) ──
# Every request names its gateway (Hubtel MoMo prompts & hosted checkout,
# Paystack / Flutterwave hosted checkouts). With no credentials anywhere the
# whole flow runs in sandbox mode: the /pay/{ref} page offers a simulate button
# and webhooks accept only clearly-sandbox references (PSK-/FLW- prefixes).
#
# Hubtel (Ghana MoMo veteran — receive-money prompts + hosted checkout):
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# HUBTEL_MERCHANT_ACCOUNT_NUMBER=
#   webhook: HUBTEL_CALLBACK_BASE + /api/webhooks/hubtel (callback passed per request)
#
# Paystack (card, bank transfer & all Ghana MoMo wallets on one checkout):
# PAYSTACK_SECRET_KEY=sk_live_… / sk_test_…
#   webhook: dashboard → /api/webhooks/paystack (x-paystack-signature = HMAC-SHA512 raw body)
#
# Flutterwave (pan-African checkout — card, MoMo, USSD, bank transfer):
# FLUTTERWAVE_SECRET_KEY=FLWSECK-…
#   webhook: dashboard → /api/webhooks/flutterwave (verif-hash = SHA-256 of the secret key)
#
# Base-URL overrides (integration testing against mock gateways):
# PAYSTACK_API_BASE=
# FLW_API_BASE=
