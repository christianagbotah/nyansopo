  createdAt DateTime   @default(now())
}

model StudyMaterial {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  classroomId   String
  classroom     Classroom @relation(fields: [classroomId], references: [id])
  subjectId     String?
  subject       Subject?  @relation(fields: [subjectId], references: [id])
  title         String
  description   String?
  linkUrl       String? // external resource / shared-drive link
  body          String? // inline notes & instructions
  authorStaffId String
  author        Staff     @relation(fields: [authorStaffId], references: [id])
  createdAt     DateTime  @default(now())
}

model SyllabusTopic {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id])
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id])
  subjectId       String
  subject         Subject   @relation(fields: [subjectId], references: [id])
  termId          String
  term            Term      @relation(fields: [termId], references: [id])
  weekNumber      Int // 1..15 — week of the term this topic is taught
  strand          String?
  subStrand       String?
  contentStandard String?
  indicator       String?
  topic           String
  completed       Boolean   @default(false)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([classroomId, subjectId, termId, weekNumber, topic])
}

// ─────────────────────────────────────────────────────────────
// SYNC-SAFE CODE ALLOCATION
// Human-readable codes (INV-YYYY-NNNN, RCP-YYYY-NNNNN, NY-YYYY-NNNNNN)
// are minted from atomic monotonic counters — never from row counts or
// read-then-write max() lookups. This makes online/offline and
// multi-device code generation conflict-free: the counter row is the
// single source of truth, updated with an atomic SQL increment.
// `next` stores the LAST allocated number for the scope.
// ─────────────────────────────────────────────────────────────
model CodeCounter {
  scope     String   @id // e.g. "INV:2026" | "RCP:2026" | "NYIDX:2016"
  next      Int      @default(0) // last allocated sequence number
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// OFFLINE RECEIPT CODE RESERVE (wave 41)
// A block of REAL receipt numbers reserved for one device. The atomic RCP
// counter jumps past the whole block at grant time, so every number in it is
// structurally exclusive to that device: online minters can never collide
// with numbers a POS tablet prints while offline, and two devices can never
// hold overlapping blocks. The offline receipt prints the final RCP code at
// once; the flush validates lease ownership (device + school + seq bounds)
// before adopting it, with receiptNo @unique + re-mint as the final backstop.
// Multiple grants per device coexist (replenishment); abandoned numbers are
// harmless gaps, never duplicates.
// ─────────────────────────────────────────────────────────────
model CodeLease {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  deviceCode String // owning device (DEV-0007 …) — adoption is validated against it
  kind       String   @default("RCP") // code kind the block was carved from
  year       Int
  fromSeq    Int // first sequence number in the block (inclusive)
  toSeq      Int // last sequence number in the block (inclusive)
  spentCount Int      @default(0) // numbers adopted at flush so far (runway accounting)
  grantedAt  DateTime @default(now())

  @@index([schoolId, deviceCode])
  @@index([schoolId, deviceCode, kind])
}

// ─────────────────────────────────────────────────────────────
// STUDENT CREDITS (invoice-scope prepaid balances from overpayment)
// iEduPro parity: overpaying an invoice creates credit that is
// auto-applied to the next bill ("LESS: Prepaid Credit Applied"),
// transferable between learners and to daily-fee wallets.
// Ledger design mirrors WalletTxn: signed amounts + balanceAfter.
// ─────────────────────────────────────────────────────────────
model StudentCredit {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  kind            String // CREDIT (overpayment/manual/refund-in/transfer-in) | APPLY (to invoice) | TRANSFER_OUT | TRANSFER_IN | DAILY_WALLET | ADJUST
  amountCents     Int // signed: + adds credit, - consumes it
  balanceAfter    Int
  invoiceId       String? // set when kind = APPLY
  sourcePaymentId String? // receipt that created an OVERPAYMENT credit
  note            String?
  byName          String?
  at              DateTime @default(now())

  @@index([schoolId, studentId])
  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────
// CRECHE / EARLY-YEARS ASSESSMENT (iEduPro parity)
// GES early-childhood reporting: developmental domains, each with
// skills rated on a school-defined abbreviation scale (EX/GD/SD/NA),
// plus ordinary numeric subjects ("no category") for written exams.
// ─────────────────────────────────────────────────────────────
model CrecheDomain {
  id        String        @id @default(cuid())
  schoolId  String
  school    School        @relation(fields: [schoolId], references: [id])
  name      String // e.g. "Communication & Language", "Motor Skills"
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  skills    CrecheSkill[]
}

model CrecheSkill {
  id        String         @id @default(cuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id])
  domainId  String
  domain    CrecheDomain   @relation(fields: [domainId], references: [id])
  name      String // observable skill / indicator
  sortOrder Int            @default(0)
  ratings   CrecheRating[]
}

model CrecheRating {
  id        String      @id @default(cuid())
  schoolId  String
  school    School      @relation(fields: [schoolId], references: [id])
  studentId String
  student   Student     @relation(fields: [studentId], references: [id])
  termId    String
  skillId   String
  skill     CrecheSkill @relation(fields: [skillId], references: [id])
  code      String // scale abbreviation (EX | GD | SD | NA...)
  byName    String?
  at        DateTime    @default(now())

  @@unique([studentId, termId, skillId])
  @@index([schoolId, termId])
}

model CrecheRatingScale {
  id        String @id @default(cuid())
  schoolId  String
  school    School @relation(fields: [schoolId], references: [id])
  code      String // EX
  label     String // Excellent
  sortOrder Int    @default(0)

  @@unique([schoolId, code])
}

// ─────────────────────────────────────────────────────────────
// SCHOOL SETTINGS KV (system_settings_modern parity)
// Simple typed key-value store for runtime configuration:
// SBA column maxes, receipt style, code formats, term runtime, etc.
// Values are stored as JSON strings.
// ─────────────────────────────────────────────────────────────
model SchoolSetting {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  key      String // e.g. "sba.classTestMax" | "receipts.style" | "term.daysOpened"
  value    String // JSON-encoded

  @@unique([schoolId, key])
}

// ─────────────────────────────────────────────────────────────
// BUDGET MANAGEMENT & FISCAL YEARS (wave 19)
// CI3 parity: Budget_management.php + Accounts.php budgets() /
// fiscal_year(). Fiscal years segment the accounting calendar
// ("2025/26"); budgets allocate expected amounts per chart account
// over a window. Utilization is computed LIVE from POSTED journal
// lines only — no cached actuals column, so posting or voiding an
// entry immediately re-flows every budget variance (same live-
// compute doctrine as ChartAccount balances). Budget codes
// (BGT-YYYY-NNNN) are sync-safe CodeCounter mints, scope BGT:<year>.
// ─────────────────────────────────────────────────────────────
model FiscalYear {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  name          String // "2025/26"
  startsAt      DateTime
  endsAt        DateTime
  status        String    @default("OPEN") // OPEN | CLOSED
  isCurrent     Boolean   @default(false)
  notes         String?
  createdByName String
  closedAt      DateTime?
  closedByName  String?
  budgets       Budget[]
  createdAt     DateTime  @default(now())

  @@index([schoolId, startsAt])
}

model Budget {
  id                 String       @id @default(cuid())
  schoolId           String
  school             School       @relation(fields: [schoolId], references: [id])
  code               String       @unique // BGT-2026-0001 (sync-safe minted)
  name               String
  fiscalYearId       String
  fiscalYear         FiscalYear   @relation(fields: [fiscalYearId], references: [id])
  startsAt           DateTime
  endsAt             DateTime
  status             String       @default("DRAFT") // DRAFT | APPROVED | CLOSED
  notes              String?
  totalBudgetedCents Int          @default(0) // denormalized SUM(lines.budgetedCents), recomputed on every line change
  createdByName      String
  approvedByName     String?
  approvedAt         DateTime?
  closedAt           DateTime?
  closedByName       String?
  createdAt          DateTime     @default(now())
  lines              BudgetLine[]

  @@index([schoolId, status])
}

model BudgetLine {
  id             String       @id @default(cuid())
  budgetId       String
  budget         Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  chartAccountId String
  chartAccount   ChartAccount @relation(fields: [chartAccountId], references: [id])
  budgetedCents  Int
  notes          String?

  @@unique([budgetId, chartAccountId])
}

// ─────────────────────────────────────────────────────────────
// STAFF ATTENDANCE & DUTY (wave 28 — the staff movement book)
// The staff-side registers every Ghanaian school keeps beside the
// learner ones: the daily Staff Attendance Book (clock-in/out with
// GES 08:00 punctuality rule), the Staff Movement Book (sign-out /
// sign-in with destination & purpose), the noticeboard duty roster
// (one holder per duty slot per weekday), the leave ledger (annual /
// sick / maternity / paternity / study / compassionate per the Ghana
// Labour Act) and the substitution cover log for absent teachers.
// ─────────────────────────────────────────────────────────────
model StaffAttendance {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id])
  staffId      String
  staff        Staff     @relation(fields: [staffId], references: [id])
  date         DateTime  @db.Date
  status       String    @default("PRESENT") // PRESENT | LATE | ABSENT | LEAVE | OFF
  clockIn      DateTime?
  clockOut     DateTime?
  note         String?
  markedByName String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([staffId, date])
  @@index([schoolId, date])
}

model LeaveRequest {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id])
  staffId         String
  staff           Staff     @relation(fields: [staffId], references: [id])
  type            String // ANNUAL | SICK | MATERNITY | PATERNITY | STUDY | COMPASSIONATE | OTHER
  startsAt        DateTime  @db.Date
  endsAt          DateTime  @db.Date
  days            Int
  status          String    @default("PENDING") // PENDING | APPROVED | DECLINED | CANCELLED
  reason          String?
  requestedByName String?
  decidedByName   String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([schoolId, status])
  @@index([staffId, startsAt])
}

model DutyAssignment {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])
  weekday   String // Monday .. Friday
  duty      String // ASSEMBLY | BREAK | CLOSING | GATE | LIBRARY | EXAMS | OTHER
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, weekday, duty])
  @@index([schoolId, staffId])
}

model StaffMovement {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id])
  staffId        String
  staff          Staff     @relation(fields: [staffId], references: [id])
  signedOutAt    DateTime  @default(now())
  signedInAt     DateTime?
  destination    String
  purpose        String?
  expectedReturn DateTime?
  status         String    @default("OUT") // OUT | BACK
  recordedByName String?

  @@index([schoolId, status])
  @@index([staffId, signedOutAt])
}

model SubstitutionLog {
  id                String        @id @default(cuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id])
  absentStaffId     String
  absentStaff       Staff         @relation("AbsentStaff", fields: [absentStaffId], references: [id])
  substituteStaffId String
  substituteStaff   Staff         @relation("SubstituteStaff", fields: [substituteStaffId], references: [id])
  date              DateTime      @db.Date
  // wave 65 — Timetable Intelligence: when the cover comes from the planner
  // it rides the exact timetable slot (period-accurate suggestions, busy
  // checks, printable day sheets). Manual staffduty entries keep slotId null.
  slotId            String?
  slot              TimetableSlot? @relation(fields: [slotId], references: [id])
  classRef          String? // "JHS 3 B9" / timetable slot label
  periods           String? // "1-3" or "Maths, English"
  note              String?
  recordedByName    String?
  createdAt         DateTime      @default(now())

  @@index([schoolId, date])
  @@index([absentStaffId])
  @@index([substituteStaffId])
  @@index([slotId])
}

// ─────────────────────────────────────────────────────────────
// FRONT OFFICE (wave 29 — the front desk books)
// The desk beside the gate every Ghanaian school keeps: the Visitors
// Book (who came, to see whom, pass number, time in/out), the
// Appointments Book (scheduled meetings with parents, staff & vendors),
// the Phone Call Log (incoming/outgoing with follow-up flags), the
// Postal Register (incoming/outgoing letters, parcels & dispatch) and
// the School Events Calendar (PTA meetings, open day, sports,
// speech & prize-giving day, vacations).
// ─────────────────────────────────────────────────────────────
model Visitor {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id])
  name           String
  phone          String?
  organisation   String?
  category       String    @default("OTHER") // PARENT | VENDOR | GOVT | ALUMNI | OTHER
  purpose        String
  personToSee    String?
  passNo         String?
  // ── wave 59: staff-linked "to see who" — selectable from the staff register,
  // drives the instant visitor-arrival alerts (SMS + email + in-app) ──
  personToSeeStaffId String?
  personToSeeStaff   Staff?  @relation("VisitorSeesStaff", fields: [personToSeeStaffId], references: [id])
  alertedSms     Boolean   @default(false) // visitor-arrival SMS delivered to the staff member
  alertedEmail   Boolean   @default(false) // visitor-arrival email delivered
  alertedInApp   Boolean   @default(false) // in-app bell item live for the staff member
  timeIn         DateTime  @default(now())
  timeOut        DateTime?
  status         String    @default("ON_SITE") // ON_SITE | DEPARTED
  badgeIssued    Boolean   @default(true)
  notes          String?
  recordedByName String?
  createdAt      DateTime  @default(now())

  @@index([schoolId, status])
  @@index([schoolId, timeIn])
}

model Appointment {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  title         String
  withName      String
  withRole      String   @default("PARENT") // PARENT | STAFF | VENDOR | GOVT | OTHER
  // wave 72 — the front-desk booking flow: the visitor is reachable & the
  // staff member is a first-class link (odd-hours rule + alerts + response)
  visitorPhone  String? // desk can call the visitor back about changes
  visitorOrg    String?
  personToSee   String? // staff member the meeting is with (display copy)
  staffId       String? // the linked staff record being visited
  staff         Staff?   @relation("AppointmentSeesStaff", fields: [staffId], references: [id])
  // APT-YYYY-NNNN reference + the one-time token behind the staff member's
  // accept / decline / reschedule link (public /appoint/{code}?t=…)
  code          String?  @unique
  decisionToken String?
  scheduledAt   DateTime
  durationMin   Int?
  location      String? // Head's office · Meeting room · Gate
  purpose       String?
  // SCHEDULED (awaiting staff response) → CONFIRMED (accepted) · DECLINED
  // (rejected) · RESCHEDULED (staff proposed a new time) → COMPLETED ·
  // CANCELLED · NO_SHOW
  status        String   @default("SCHEDULED")
  outcome       String?
  notes         String?
  // response trail (wave 72 — who answered the request, when & how)
  respondedAt       DateTime?
  respondedByName   String?
  respondedByUserId String?
  responseNote      String? // decline reason / reschedule note
  rescheduledFrom   DateTime? // the original slot when the time was moved
  reminderSentAt    DateTime? // T-2-min SMS reminder to the staff (dedupe)
  alertedSms     Boolean  @default(false) // request SMS delivered to the staff member
  alertedEmail   Boolean  @default(false)
  alertedInApp   Boolean  @default(false) // bell item live for the staff member
  relayedAt      DateTime? // desk acknowledged the decision & told the visitor
  createdByName String?
  createdByStaffId String? // the desk officer who booked (gets decision SMS)
  createdByStaff   Staff?  @relation("AppointmentBookedBy", fields: [createdByStaffId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, scheduledAt])
  @@index([schoolId, status])
  @@index([schoolId, staffId, status])
}

model PhoneCall {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  direction     String // INCOMING | OUTGOING
  contactName   String
  phone         String?
  regarding     String
  handledByName String?
  followUp      Boolean  @default(false)
  followUpDone  Boolean  @default(false)
  calledAt      DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  @@index([schoolId, calledAt])
  @@index([schoolId, followUp])
}

model PostalItem {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id])
  direction      String // INCOMING | OUTGOING
  type           String    @default("LETTER") // LETTER | PARCEL | DOCUMENT | COURIER
  refNo          String?
  fromParty      String
  toParty        String
  receivedAt     DateTime
  dispatchedAt   DateTime?
  collectedBy    String?
  status         String    @default("PENDING") // PENDING | DISPATCHED | COLLECTED
  notes          String?
  recordedByName String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, receivedAt])
}

// Certificates & documents (wave 30): serial-numbered official documents —
// school leaving certificates, testimonials, admission & introductory letters.
// Particulars are SNAPSHOTTED at issue time (name / index / class / session)
// so a printed document stays historically accurate after rollover, transfer
// or graduation. Serials are per school+type: SLC-2026-0001, TSM-…, ADL-…, INT-…
model IssuedDocument {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  type          String // LEAVING_CERT | TESTIMONIAL | ADMISSION_LETTER | INTRO_LETTER
  serialNo      String
  issueDate     DateTime  @db.Date
  // snapshot particulars at issue time
  studentName   String
  studentIndex  String
  className     String
  sessionYear   String
  dateOfBirth   DateTime? @db.Date
  reason        String? // reason for leaving / transfer (SLC & intro letters)
  remarks       String? // conduct / academic remarks woven into the prose
  status        String    @default("ISSUED") // ISSUED | REVOKED
  issuedByName  String?
  revokedByName String?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@unique([schoolId, serialNo])
  @@index([schoolId, type])
  @@index([schoolId, issueDate])
  @@index([studentId])
}

model SchoolEvent {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  termId        String?
  term          Term?     @relation(fields: [termId], references: [id])
  title         String
  category      String    @default("OTHER") // PTA_MEETING | OPEN_DAY | SPORTS | PRIZE_GIVING | EXAMINATION | HOLIDAY | OTHER
  startsAt      DateTime  @db.Date
  endsAt        DateTime? @db.Date
  location      String?
  description   String?
  audience      String    @default("ALL") // ALL | STAFF | PARENTS | STUDENTS
  createdByName String?
  createdAt     DateTime  @default(now())

  @@index([schoolId, startsAt])
  @@index([termId])
}

// ── Wave 31 · Audit trail — the compliance book (iEduPro audit_trail parity) ──
// Every consequential act in the school's books leaves an immutable line:
// who did it, what they touched, and the before/after state as JSON diffs.
// Money records (payments, invoices), results publishing, certificates,
// staff duty and RBAC changes all post here. The viewer renders side-by-side
// Before / After panes exactly like the legacy audit_log_viewer.
model AuditLog {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  actorId     String? // User id when the actor has a login
  actorName   String
  actorRole   String? // SUPER_ADMIN | SCHOOL_ADMIN | ACCOUNTANT | CASHIER | TEACHER…
  action      String // CREATE | UPDATE | DELETE | ISSUE | REVOKE | REINSTATE | PUBLISH | UNPUBLISH | APPROVE | REJECT | LOCK | UNLOCK | VOID | EXPORT | ADJUST | TRANSFER | LOGIN
  entityType  String // PAYMENT | INVOICE | STUDENT | RESULT | CERTIFICATE | STAFF | TIMETABLE | RBAC | FEES | ATTENDANCE | SETTING…
  entityId    String?
  entityLabel String? // receipt number / serial / student name — the human handle
  summary     String
  beforeJson  Json? // row state before the change
  afterJson   Json? // row state after the change
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([schoolId, entityType, entityId])
  @@index([schoolId, actorId])
}

// ── Wave 36 · Financial alert resolutions (legacy financial_alerts parity) ──
// The alert engine evaluates five live rules (critical receivables, collection
// efficiency vs target, overdue bank reconciliation, rapid collector
// transaction patterns, daily-target success) against school ops data.
// A resolution mutes ONE alert key for 7 days (legacy
// is_alert_resolved: resolved_at > now − 7d); the resolution history is the
// compliance trail of who closed which alert, with a note.
model FinancialAlertResolution {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  alertKey       String // debt_<studentId> | efficiency_<yyyy-mm-dd> | recon_<accountId> | rapid_<collector>_<yyyymmddhh> | success_<yyyy-mm-dd>
  title          String // frozen snapshot — the history keeps the wording that was shown
  severity       String // CRITICAL | HIGH | MEDIUM | LOW
  category       String // Receivables | Performance | Reconciliation | Anomaly Detection | Success
  description    String? // frozen snapshot of the alert body
  resolvedByName String
  notes          String? // what the bursar actually did about it
  resolvedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([schoolId, alertKey, resolvedAt])
  @@index([schoolId, resolvedAt])
}

// ── Wave 37 · Benefit categories & beneficiaries (legacy benefit_category /
// beneficiary_list / benefit_categories.php parity) ──
// Learners on government or social-support programs (School Feeding,
// Capitation Grant, LEAP, scholarships). A category defines how much of each
// service line is charged to beneficiaries, per class ('a' = all classes);
// the beneficiary row stamps the learner onto categories for one term.
model BenefitCategory {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  name          String // legacy stores uppercase
  code          String?
  detailsJson   Json? // { discountType: "percentage"|"amount", classes: { [classId|"a"]: { feedingCents, classesCents, tuitionCents } } }
  active        Boolean  @default(true)
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, name])
}

model Beneficiary {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  termId        String
  term          Term     @relation(fields: [termId], references: [id])
  classroomName String? // enrollment snapshot for the register
  categoriesJson Json? // [{ categoryId, name, feedingCents, classesCents, tuitionCents }] — frozen amounts
  note          String?
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, termId])
  @@index([schoolId, termId])
}

// ── wave 39 — Sync Center (CI3 sync_devices / sync_conflicts / sync_audit_log /
//    sync_metrics / location_registry parity, adapted to the PWA offline queue)
//
//    The legacy system synced WAMP servers ↔ cloud with per-table metadata and a
//    conflict queue. Nyansapo's truth is the browser offline queue: devices are
//    the browsers/scanners that hold queued ops, conflicts are replay-vs-server
//    collisions detected at flush time, and SyncEvent journals every flush.

// a registered device (browser / POS tablet / attendance scanner) that can hold
// a queued offline ops. Auto-registers itself on its first flush — CI3
// register_device() parity — and can be revoked to reject future flushes.
model SyncDevice {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  code       String    @unique // DEV-0001 style, minted at registration
  name       String
  kind       String // POS_TABLET | SCANNER | FRONT_DESK | BROWSER | OTHER
  status     String    @default("ACTIVE") // ACTIVE | REVOKED
  lastSyncAt DateTime? // last successful flush
  lastSeenAt DateTime? // last flush attempt (incl. failed)
  lastIP     String?
  lastUser   String? // name of the user who last flushed from it
  opsSynced  Int       @default(0) // lifetime ops applied from this device
  opsFailed  Int       @default(0)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([schoolId, status])
}

// a replay-vs-server collision detected at flush time (CI3 sync_conflicts parity:
// both sides frozen as JSON, resolved by local-wins / remote-wins / ignore).
//   marks      — queued score ≠ the server's current score for that assessment
//   attendance — a session for the same class + date was taken online after queue
model SyncConflict {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  deviceCode  String? // originating device (the "local" side)
  localUser   String // name of the user whose queued op collided
  table       String // attendance | marks
  recordKey   String // human description of the colliding record
  localState  String // JSON — the queued op's payload
  remoteState String // JSON — the server state at flush time
  localAt     DateTime // when the op was queued
  remoteAt    DateTime // when the server row was last touched
  status      String    @default("PENDING") // PENDING | RESOLVED | IGNORED
  resolution  String? // LOCAL_WINS | REMOTE_WINS | IGNORED
  resolvedBy  String?
  resolvedAt  DateTime?
  resolveNote String?
  createdAt   DateTime  @default(now())

  @@index([schoolId, status])
}

// the sync journal (CI3 sync_audit_log + sync_metrics parity): one row per flush
// with ops synced/failed/conflicts and duration — the dashboard's raw material.
model SyncEvent {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  deviceCode String?
  userName   String
  kind       String // FLUSH | REGISTER | REVOKE | RESOLVE
  opsSynced  Int       @default(0)
  opsFailed  Int       @default(0)
  conflicts  Int       @default(0)
  durationMs Int?
  detail     String?
  createdAt  DateTime  @default(now())

  @@index([schoolId, createdAt])
}

// ── wave 38 — receivables intelligence (CI3 aging_report / drivelist_reminder_templates parity)
model ReminderTemplate {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  name          String
  content       String // placeholders: {{student}} {{student_id}} {{parent_name}} {{class_name}} {{amount_owe}} {{expected_date}} {{school_name}} {{current_date}}
  isDefault     Boolean  @default(false)
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId])
}

// ── wave 54 — public school website (CI3 frontend_pages / Frontend_model parity)
// One published site per school at /site/{school.code}: hero slider, events
// (reuses SchoolEvent audience=ALL), news, gallery albums, staff page, about,
// terms & privacy pages and a contact inbox.
model SiteSetting {
  id             String  @id @default(cuid())
  schoolId       String  @unique
  school         School  @relation(fields: [schoolId], references: [id])
  published      Boolean @default(false)
  // 3 slides as JSON: [{title, description, imageId}] — imageId = MediaAsset id
  sliderJson     String  @default("[]")
  aboutUs        String?
  aboutUsImageId String?
  terms          String?
  privacy        String?
  contactEmail   String?
  contactPhone   String?
  updatedAt      DateTime @updatedAt
}

model SiteNews {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  title       String
  body        String
  imageId     String?
  publishedAt DateTime @default(now())

  @@index([schoolId, publishedAt])
}

model SiteGalleryAlbum {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  title         String
  description   String?
  showOnWebsite Boolean  @default(true)
  coverId       String?
  createdAt     DateTime @default(now())
  images        SiteGalleryImage[]

  @@index([schoolId, createdAt])
}

model SiteGalleryImage {
  id        String  @id @default(cuid())
  albumId   String
  album     SiteGalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  imageId   String // MediaAsset id
  caption   String?
  createdAt DateTime @default(now())

  @@index([albumId])
}

model SiteContactMessage {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  firstName String
  lastName  String?
  email     String?
  phone     String?
  address   String?
  comment   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
}

// ── wave 55 — school siren & bell management · wave 61 Siren Pro ──
// The electronic substitute for the hand bell: timetabled rings (assembly,
// change of lesson, break, closing) plus a live console for manual rings —
// with a full firing history. Schedules fire from any open console client.
// wave 61 adds the features schools buy standalone bell systems for:
//   • day PROFILES — separate Normal / Exam / Event day timetables, one-tap switch
//   • ZONES — tag rings to campus areas; each console device picks its zone
//   • per-ring VOLUME and FADE-IN (gentle starts for assemblies)
//   • PERIOD BELLS — repeat every N minutes until an end time
//   • vacation awareness — rings can auto-pause outside the active term
model SirenSchedule {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  label          String   // e.g. "Morning assembly", "End of break"
  time           String   // "HH:MM" 24-hour
  daysJson       String   @default("[1,2,3,4,5]") // weekday indices 0=Sun..6=Sat
  sound          String   @default("BELL") // BELL | SIREN | CHIME | KLAXON | BUGLE | "CUSTOM:<toneId>"
  durationSec    Int      @default(10)
  enabled        Boolean  @default(true)
  profile        String   @default("Normal Day") // day-profile grouping (Normal Day | Exam Day | …)
  zone           String   @default("All Campus") // campus zone the ring targets
  volume         Int      @default(100) // 10..100 — ring loudness on this device
  fadeIn         Int      @default(0) // 0..5 seconds gentle ramp-up
  repeatEveryMin Int?     // period bells: repeat every N minutes from `time`
  endTime        String?  // "HH:MM" — last repeat occurrence (with repeatEveryMin)
  skipVacation   Boolean  @default(true) // auto-pause outside the active term
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([schoolId, time])
}

model SirenEvent {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  scheduleId  String?  // set when fired from a schedule
  label       String
  sound       String
  durationSec Int
  kind        String   @default("MANUAL") // MANUAL | SCHEDULED | TEST | ANNOUNCEMENT
  byName      String
  byRole      String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([schoolId, scheduleId, createdAt])
}

// ── wave 56 — Nyansapo Office (Microsoft Office-like portal) ──
// Teachers & staff type documents, workbooks and presentations directly in
// the system. kind: DOC (word processor) | SHEET (spreadsheet) | SLIDE
// (presentation) — contentJson holds the kind-specific editor state.
model OfficeFile {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  kind          String   // DOC | SHEET | SLIDE
  title         String
  folder        String   @default("My Documents")
  contentJson   String   @default("{}")
  createdByName String
  updatedByName String
  starred       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, kind, updatedAt])
}

// ─────────────────────────────────────────────────────────────
// HOMEWORK & ASSIGNMENTS (wave 65 — the daily teacher workflow)
// A teacher posts an assignment to a class with a due date; every ACTIVE
// learner in the class gets a PENDING submission row (the teacher's marking
// checklist). Parents receive an SMS the moment it is posted (opt-out per
// post), learners see it in their portal and can self-submit with a note,
// the teacher marks handed-in / scores / feedback, and can push the scores
// into the Gradebook as a HOMEWORK assessment with one tap.
model Homework {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  classroomId   String
  classroom     Classroom @relation(fields: [classroomId], references: [id])
  subjectId     String?
  subject       Subject?  @relation(fields: [subjectId], references: [id])
  subjectName   String // free-text fallback when the subject is not in the catalog
  staffId       String?
  staff         Staff?    @relation(fields: [staffId], references: [id])
  termId        String?
  term          Term?     @relation(fields: [termId], references: [id])
  title         String
  instructions  String
  dueDate       DateTime
  maxScore      Int       @default(10)
  status        String    @default("OPEN") // OPEN | CLOSED
  notifyParents Boolean   @default(true)
  createdByName String
  submissions   HomeworkSubmission[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([schoolId, classroomId, dueDate])
}

model HomeworkSubmission {
  id           String    @id @default(cuid())
  homeworkId   String
  homework     Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  status       String    @default("PENDING") // PENDING | SUBMITTED | LATE | GRADED | EXCUSED
  note         String? // learner/parent submission note
  submittedAt  DateTime?
  score        Float?
  feedback     String?
  gradedAt     DateTime?
  gradedByName String?
  createdAt    DateTime  @default(now())

  @@unique([homeworkId, studentId])
  @@index([homeworkId])
  @@index([studentId])
}

/* wave 67 — Exam Hall & Seating Planner: one row per printable seating chart.
   entriesJson carries the seat grid: [{ seat, studentId, name, indexNo,
   className }] in seat order (row-major). interleave=true rounds classes
   seat-by-seat so neighbours always come from different classes — the
   anti-copying pattern every Ghanaian exam hall runs on. */
model ExamSeatingPlan {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  title          String
  examName       String?
  rows           Int      @default(6)
  cols           Int      @default(6)
  interleave     Boolean  @default(true)
  classroomNames String   @default("") // comma-separated source classes
  entriesJson    String   @default("[]")
  candidateCount Int      @default(0)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([schoolId, updatedAt])
}

/* wave 70 — Exam Timetable & Invigilation: the printed docket every Ghanaian
   hall runs on — subject × date × start × duration × venue with named
   invigilators. Clash-guarded at the API: a class, a venue or an invigilator
   can never be scheduled into two overlapping papers on the same day. */
model ExamTimetableEntry {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id])
  examName       String
  classroomId    String
  classroom      Classroom @relation(fields: [classroomId], references: [id])
  subjectName    String
  date           DateTime  @db.Date
  startMinute    Int // minutes from midnight
  durationMin    Int       @default(60)
  venue          String?
  invigilatorIds String    @default("") // comma-separated staff ids
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([schoolId, examName, date])
}

/* wave 69 — Payment Plans (installments): the Ghanaian way of paying school
   fees. One ACTIVE plan per invoice splits the remaining balance into dated
   installments the bursar can track, remind (SMS) and settle against.
   OVERDUE is derived (dueDate < today && status = OPEN), never stored. */
model PaymentPlan {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  status        String   @default("ACTIVE") // ACTIVE | SETTLED | CANCELLED
  createdByName String
  note          String?
  installments  PaymentPlanInstallment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, status])
  @@index([invoiceId])
}

model PaymentPlanInstallment {
  id            String      @id @default(cuid())
  planId        String
  plan          PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sequence      Int
  label         String?
  amountCents   Int
  dueDate       DateTime
  status        String      @default("OPEN") // OPEN | PAID
  paidCents     Int         @default(0)
  paidAt        DateTime?
  receiptNo     String?
  settledByName String?
  createdAt     DateTime    @default(now())

  @@index([planId, sequence])
  @@index([dueDate])
}

/* wave 71 — Guidance & Counselling (G&C) unit: the confidential case file
   every GES school must keep, separate from the discipline register.
   A case is a concern about ONE learner; sessions log the counselling
   conversations; follow-ups track promises made ("check on Kwame Friday").
   CONFIDENTIAL cases are only visible to the assigned counsellor, the
   opener and counsel.manage holders (head / G&C coordinator). ABUSE_REPORT
   cases are always confidential and high-severity by construction. */
model CounselCase {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  caseNo         String   // GC-2026-001 — derived per school per year
  category       String   // ACADEMIC | BEHAVIOURAL | FAMILY | HEALTH | CAREER | PEER | ATTENDANCE | FINANCIAL | ABUSE_REPORT | OTHER
  severity       String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status         String   @default("OPEN") // OPEN | IN_PROGRESS | MONITORING | RESOLVED | REFERRED
  source         String   @default("TEACHER_REFERRAL") // TEACHER_REFERRAL | SELF | PARENT | DISCIPLINE | ATTENDANCE | HEALTH | ANON
  title          String
  summary        String?  @db.Text
  confidential   Boolean  @default(true)
  assignedToId   String?
  assignedTo     Staff?   @relation("CounselAssigned", fields: [assignedToId], references: [id])
  referredExternal String? // DOVVSU · Social Welfare · hospital · CHPS — named on REFERRED
  openedByStaffId String?
  openedBy        Staff?  @relation("CounselOpened", fields: [openedByStaffId], references: [id])
  openedByName   String
  closedAt       DateTime?
  closedNote     String?
  sessions       CounselSession[]
  followUps      CounselFollowUp[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, studentId])
  @@index([assignedToId])
}

model CounselSession {
  id          String      @id @default(cuid())
  caseId      String
  case        CounselCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  heldAt      DateTime
  mode        String      @default("FACE_TO_FACE") // FACE_TO_FACE | GROUP | PHONE | HOME_VISIT
  notes       String      @db.Text // raw counsellor notes (confidential)
  aiSummary   String?     @db.Text // drafted professional summary (AI-assist)
  outcome     String? // IMPROVED | NO_CHANGE | WORSE | ESCALATED
  attendees   String? // who was present ("learner + mother")
  loggedByName String
  createdAt   DateTime    @default(now())

  @@index([caseId, heldAt])
}

model CounselFollowUp {
  id        String      @id @default(cuid())
  caseId    String
  case      CounselCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  dueAt     DateTime
  note      String
  doneAt    DateTime?
  doneNote  String?
  remindedAt DateTime? // last reminder SMS to the assigned counsellor
  createdAt DateTime    @default(now())

  @@index([caseId, dueAt])
  @@index([dueAt])
}
