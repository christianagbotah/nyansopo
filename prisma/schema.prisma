// Nyansapo — The Wisdom Knot That Binds Ghana's Schools
// Full data model for the Ghanaian private-school ecosystem:
// association hierarchy (GNACOPS-style), school groups & branches, students,
// cross-school transfer tracking, defaulter flags, fees, attendance,
// gradebook, report cards, AI insights.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ASSOCIATION HIERARCHY (National → Regional → District → Zone)
// ─────────────────────────────────────────────────────────────
model AssociationNode {
  id            String            @id @default(cuid())
  code          String            @unique
  name          String
  level         String // NATIONAL | REGIONAL | DISTRICT | ZONE
  region        String?
  meetingTown   String?
  leadTitle     String? // e.g. "National Executive Director"
  leadName      String?
  parentId      String?
  parent        AssociationNode?  @relation("NodeTree", fields: [parentId], references: [id])
  children      AssociationNode[] @relation("NodeTree")
  schools       School[]
  users         User[]
  announcements Announcement[]
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  password          String
  fullName          String
  phone             String?
  role              String // ASSOCIATION_* | GROUP_OWNER | SUPER_ADMIN | SCHOOL_ADMIN | ACCOUNTANT | CASHIER | BUS_CONDUCTOR | TEACHER | NON_TEACHING | LIBRARIAN | PARENT | STUDENT
  title             String? // display title e.g. "National Executive Director", "Headteacher"
  associationNodeId String?
  associationNode   AssociationNode? @relation(fields: [associationNodeId], references: [id])
  schoolGroupId     String?
  schoolGroup       SchoolGroup?     @relation(fields: [schoolGroupId], references: [id])
  schoolId          String?
  school            School?          @relation(fields: [schoolId], references: [id])
  avatarSeed        String?
  // ── RBAC (iEduPro admin-level parity) ──
  status            String           @default("ACTIVE") // ACTIVE | SUSPENDED
  permissionsJson   String? // JSON { extra: string[], denied: string[] } — overrides on top of role defaults
  lastLoginAt       DateTime?
  staffId           String? // link to Staff record — staff self-service portal (payslips, profile)
  staff             Staff?          @relation("UserStaff", fields: [staffId], references: [id])
  studentId         String? // link to Student record — student portal (own record only)
  linkedStudentIds  String? // JSON array of student ids — parent portal (own children only)
  createdAt         DateTime         @default(now())
}

// ─────────────────────────────────────────────────────────────
// SCHOOL GROUPS (multi-branch proprietors) & SCHOOLS
// ─────────────────────────────────────────────────────────────
model SchoolGroup {
  id             String   @id @default(cuid())
  name           String
  proprietorName String
  contactPhone   String?
  contactEmail   String?
  schools        School[]
  users          User[]
}

model School {
  id                   String                @id @default(cuid())
  name                 String
  code                 String                @unique
  motto                String?
  curriculum           String // GES | CAIE | IB
  curriculumStages     String? // JSON: stage labels per curriculum
  category             String // LOW_FEE | MID_TIER | PREMIUM | INTERNATIONAL
  associationNodeId    String
  associationNode      AssociationNode       @relation(fields: [associationNodeId], references: [id])
  groupId              String?
  group                SchoolGroup?          @relation(fields: [groupId], references: [id])
  isBranchMain         Boolean               @default(false)
  region               String
  district             String
  town                 String
  gpsAddress           String?
  phone                String?
  email                String?
  nasiaRegNo           String?
  nasiaStatus          String                @default("PENDING") // LICENSED | PROVISIONAL | PENDING | EXPIRED
  gnacopsStatus        String                @default("PENDING") // VERIFIED | PENDING | LAPSED
  gnacopsMemberSince   DateTime?
  establishedYear      Int?
  studentsOnRoll       Int                   @default(0)
  logoColor            String                @default("#0F6B47")
  createdAt            DateTime              @default(now())
  users                User[]
  classrooms           Classroom[]
  academicYears        AcademicYear[]
  feeStructures        FeeStructure[]
  invoices             Invoice[]
  payments             Payment[]
  enrollments          Enrollment[]
  assessments          Assessment[]
  attendanceSessions   AttendanceSession[]
  subjects             Subject[]
  staff                Staff[]
  timetableSlots       TimetableSlot[]
  flagsRaised          StudentFlag[]         @relation("FlagsRaised")
  transfersFrom        TransferRecord[]      @relation("TransfersFrom")
  transfersTo          TransferRecord[]      @relation("TransfersTo")
  recordRequestsFrom   RecordRequest[]       @relation("RequestsFrom")
  recordRequestsTo     RecordRequest[]       @relation("RequestsTo")
  inquiries            AdmissionInquiry[]
  onlineExams          OnlineExam[]
  onlineExamAttempts   OnlineExamAttempt[]
  announcements        Announcement[]
  riskScores           RiskScore[]
  dailyServices        DailyService[]
  dailyCharges         DailyCharge[]
  transportRoutes      TransportRoute[]
  vehicles             Vehicle[]
  drivers              DriverRecord[]
  pensionProviders     PensionProvider[]
  remarkTemplates      RemarkTemplate[]
  conductItems         ConductItem[]
  discountProfiles     DiscountProfile[]
  smsSetting           SmsSetting?
  smsTemplates         SmsTemplate[]
  smsAutomations       SmsAutomation[]
  smsMessages          SmsMessage[]
  payrollRuns          PayrollRun[]
  inventoryItems       InventoryItem[]
  stockMovements       StockMovement[]
  suppliers            Supplier[]
  discounts            Discount[]
  discountApplications DiscountApplication[]
  expenses             Expense[]
  purchaseOrders       PurchaseOrder[]
  opsSettings          OpsSetting[]
  studentWallets       StudentWallet[]
  walletTxns           WalletTxn[]
  libraryBooks        LibraryBook[]
  libraryLoans        LibraryLoan[]
  bookRequests        BookRequest[]
  boardingHouses      BoardingHouse[]
  dormitories         Dormitory[]
  beds                Bed[]
  questionPapers      QuestionPaper[]
  modificationRequests ModificationRequest[]
  rawScoreGrades      RawScoreGrade[]
  portfolioEntries    PortfolioEntry[]
  dailyFeeAudits      DailyFeeAudit[]
  handoverReports     HandoverReport[]
  lessonNoteTemplates LessonNoteTemplate[]
  lessonNotes         LessonNote[]
  studyMaterials      StudyMaterial[]
  syllabusTopics      SyllabusTopic[]
  studentCredits      StudentCredit[]
  crecheDomains       CrecheDomain[]
  crecheSkills        CrecheSkill[]
  crecheRatingScales  CrecheRatingScale[]
  crecheRatings       CrecheRating[]
  schoolSettings      SchoolSetting[]
  mediaAssets         MediaAsset[]
  serviceBalances     ServiceBalance[]
}

// ─────────────────────────────────────────────────────────────
// ACADEMIC CALENDAR
// ─────────────────────────────────────────────────────────────
model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String // "2026/2027"
  isCurrent Boolean  @default(false)
  startsAt  DateTime
  endsAt    DateTime
  terms     Term[]
}

model Term {
  id                 String              @id @default(cuid())
  academicYearId     String
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])
  name               String // First Term | Second Term | Third Term
  sequence           Int
  startsAt           DateTime
  endsAt             DateTime
  isCurrent          Boolean             @default(false)
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  assessments        Assessment[]
  attendanceSessions AttendanceSession[]
  reportCards        ReportCard[]
  lessonNotes        LessonNote[]
  syllabusTopics     SyllabusTopic[]
}

// ─────────────────────────────────────────────────────────────
// CLASSES, SUBJECTS, STAFF
// ─────────────────────────────────────────────────────────────
model Classroom {
  id                 String              @id @default(cuid())
  schoolId           String
  school             School              @relation(fields: [schoolId], references: [id])
  name               String // "Basic 4 Gold"
  gradeLevel         String // KG1..B9 | Year 1..13 | PYP 1..MYP 4
  stageLabel         String? // "Primary (SBC)" | "Cambridge Lower Secondary" | "IB MYP"
  capacity           Int                 @default(30)
  classTeacherId     String?
  classTeacher       Staff?              @relation(fields: [classTeacherId], references: [id])
  enrollments        Enrollment[]
  feeStructures      FeeStructure[]
  assessments        Assessment[]
  attendanceSessions AttendanceSession[]
  timetableSlots     TimetableSlot[]
  dailyServiceRates  DailyServiceRate[]
  onlineExams        OnlineExam[]
  questionPapers     QuestionPaper[]
  lessonNoteTemplates LessonNoteTemplate[]
  lessonNotes        LessonNote[]
  studyMaterials     StudyMaterial[]
  syllabusTopics     SyllabusTopic[]
}

model Subject {
  id             String          @id @default(cuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id])
  name           String
  code           String
  curriculum     String?
  isCore         Boolean         @default(true)
  assessments    Assessment[]
  timetableSlots TimetableSlot[]
  lessonNoteTemplates LessonNoteTemplate[]
  lessonNotes    LessonNote[]
  studyMaterials StudyMaterial[]
  syllabusTopics SyllabusTopic[]
}

model Staff {
  id             String          @id @default(cuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id])
  fullName       String
  role           String // HEADTEACHER | TEACHER | ACCOUNTANT | ASSISTANT | BURSAR
  title          String?
  email          String?
  phone          String?
  subjects       String? // comma-separated
  // staff category & position (iedupro parity: teacher / non-teaching / administrator)
  category       String          @default("TEACHING") // TEACHING | NON_TEACHING | ADMINISTRATION
  position       String? // e.g. Driver, Cook, Librarian, Security Guard, IT Technician
  qualification  String? // highest qualification / designation
  department     String? // Maintenance / Kitchen / Security / Transport ...
  staffCode      String? // TCR-00001 / NTS-00001 style identifier
  // payroll
  salaryCents    Int             @default(0) // basic monthly salary
  employmentType String          @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT | CASUAL
  ssnitNumber    String?
  tin            String?
  tier2Provider  String? // licensed Tier 2 pension manager (e.g. Petra Trust)
  tier2MemberId  String? // tier-2 membership number with the provider
  ghanaCardId    String? // Ghana Card number (GHA-XXXXXXXXX-X)
  birthday       DateTime?
  sex            String? // M | F
  address        String?
  accountNumber  String? // bank / momo account (masked in UI)
  momoNumber     String?
  bankName       String?
  hiredAt        DateTime?
  // SMS notification preference (iedupro user_notification_preferences parity):
  // per-teacher opt-out for lesson-note return/endorse alerts; school-level kill
  // switch lives on SmsSetting.autoLessonNoteAlerts
  smsNotify      Boolean         @default(true)
  active         Boolean         @default(true)
  classrooms       Classroom[]
  payslips         Payslip[]
  timetableSlots  TimetableSlot[]
  users            User[]         @relation("UserStaff")
  housesMastered   BoardingHouse[] @relation("HouseMaster")
  lessonNotes      LessonNote[]
  studyMaterials   StudyMaterial[]
}

// ─────────────────────────────────────────────────────────────
// STUDENTS (national registry via nyansapoIndex)
// ─────────────────────────────────────────────────────────────
model Student {
  id                   String                   @id @default(cuid())
  nyansapoIndex        String                   @unique // NY-YYYY-NNNNNN national student index
  firstName            String
  lastName             String
  otherNames           String?
  gender               String // M | F
  dateOfBirth          DateTime?
  photoSeed            String?
  guardianName         String
  guardianPhone        String
  guardianAltPhone     String?
  guardianEmail        String?
  guardianOccupation   String?
  guardianAddress      String?
  relationship         String                   @default("Parent")
  hometown             String?
  previousSchool       String?
  // father / mother detail (iEduPro student_add_new parity)
  fatherName           String?
  fatherPhone          String?
  fatherOccupation     String?
  motherName           String?
  motherPhone          String?
  motherOccupation     String?
  // medical & background (iEduPro parity)
  nationality          String?
  religion             String?
  bloodGroup           String? // A+ | A- | B+ | B- | AB+ | AB- | O+ | O-
  allergies            String?
  medicalConditions    String?
  emergencyContact     String?
  photoUrl             String? // portrait data-URL (resized client-side at intake)
  dietNote             String? // special-diet flag (iEduPro student_on_special_diet): allergies, vegetarian, religious observance…
  syncClientId         String?                  @unique // offline-queue clientId that created this row — makes /api/sync re-flush idempotent
  status               String                   @default("ACTIVE") // ACTIVE | TRACKED (not currently enrolled)
  createdAt            DateTime                 @default(now())
  enrollments          Enrollment[]
  invoices             Invoice[]
  marks                Mark[]
  attendanceRecords    AttendanceRecord[]
  flags                StudentFlag[]
  reportCards          ReportCard[]
  transfers            TransferRecord[]
  recordRequests       RecordRequest[]
  inquiries            AdmissionInquiry[]
  riskScores           RiskScore[]
  serviceEnrollments   DailyServiceEnrollment[]
  wallet               StudentWallet?
  walletTxns           WalletTxn[]
  serviceBalances      ServiceBalance[]
  dailyCharges         DailyCharge[]
  transportAssignments TransportAssignment[]
  smsMessages          SmsMessage[]
  discountApplications DiscountApplication[]
  libraryLoans         LibraryLoan[]
  bookRequests         BookRequest[]
  portfolioEntries     PortfolioEntry[]
  dailyFeeAudits       DailyFeeAudit[]
  bedAssigned          Bed?                @relation("BedOccupant")
  housePrefectOf       BoardingHouse[]    @relation("HousePrefect")
  dormPrefectOf        Dormitory[]        @relation("DormitoryPrefect")
  onlineExamAttempts  OnlineExamAttempt[]
  stockIssues          StockMovement[]
  posPayments          Payment[]
  credits              StudentCredit[]
  crecheRatings        CrecheRating[]
}

model Enrollment {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  classroomId   String
  classroom     Classroom @relation(fields: [classroomId], references: [id])
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  rollNo        Int?
  admissionDate DateTime
  exitDate      DateTime?
  status        String    @default("ACTIVE") // ACTIVE | WITHDRAWN | TRANSFERRED | GRADUATED | EXPELLED
  exitReason    String?
  // promotion trail (iEduPro student_promotion parity): the class the learner
  // was moved up from, and when — the placement row itself is reassigned
  promotedFromName String?
  promotedAt       DateTime?
  // boarding (iEduPro enroll.residence_type): DAY | BOARDING
  residenceType    String    @default("DAY")
}

// Weekly class routine (timetable). Day 1 = Monday … 5 = Friday (0/6 weekend).
model TimetableSlot {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  subjectId   String?
  subject     Subject?  @relation(fields: [subjectId], references: [id])
  staffId     String?
  staff       Staff?    @relation(fields: [staffId], references: [id])
  subjectName String // free-text fallback when subject not in catalog
  dayOfWeek   Int // 1–5 (Mon–Fri); 0 Sunday, 6 Saturday
  startMinute Int // minutes from midnight, e.g. 480 = 08:00
  endMinute   Int
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([schoolId, classroomId, dayOfWeek, startMinute])
}

// ─────────────────────────────────────────────────────────────
// FEES, INVOICES, PAYMENTS
// ─────────────────────────────────────────────────────────────
model FeeStructure {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  termId      String
  term        Term      @relation(fields: [termId], references: [id])
  items       FeeItem[]
  totalCents  Int       @default(0)
}

model FeeItem {
  id             String       @id @default(cuid())
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  name           String
  amountCents    Int
  isOptional     Boolean      @default(false)
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNo      String        @unique
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id])
  termId         String
  term           Term          @relation(fields: [termId], references: [id])
  classroomName  String?
  items          InvoiceItem[]
  totalCents     Int           @default(0)
  discountCents  Int           @default(0)
  discountReason String?
  paidCents      Int           @default(0)
  status         String        @default("UNPAID") // PAID | PARTIAL | UNPAID | OVERDUE | WRITTEN_OFF
  dueDate        DateTime?
  paymentPlan    String        @default("FULL") // FULL | INSTALLMENTS
  writtenOff     Boolean       @default(false)
  writeOffNote   String? // audit: who wrote off, original amount, reason
  createdAt      DateTime      @default(now())
  payments       Payment[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  name        String
  amountCents Int
}

model Payment {
  id             String        @id @default(cuid())
  receiptNo      String        @unique
  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  studentId      String?
  student        Student?      @relation(fields: [studentId], references: [id])
  category       String        @default("INVOICE") // INVOICE | DAILY
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id])
  amountCents    Int
  method         String // CASH | MOMO_MTN | MOMO_TELECEL | MOMO_AT | BANK | CHEQUE | CARD
  paymentType    String        @default("PAYMENT") // PAYMENT | REFUND | CREDIT
  reference      String?
  bankName       String?
  chequeNo       String?
  receivedByName String?
  paidAt         DateTime
  recordedAt     DateTime      @default(now())
  offlineQueued  Boolean       @default(false)
  syncedAt       DateTime?
  voided         Boolean       @default(false)
  dailyCharges   DailyCharge[]
}

// ─────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────
model AttendanceSession {
  id          String             @id @default(cuid())
  classroomId String
  classroom   Classroom          @relation(fields: [classroomId], references: [id])
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id])
  termId      String
  term        Term               @relation(fields: [termId], references: [id])
  date        DateTime
  takenByName String?
  records     AttendanceRecord[]
}

model AttendanceRecord {
  id            String            @id @default(cuid())
  sessionId     String
  session       AttendanceSession @relation(fields: [sessionId], references: [id])
  studentId     String
  student       Student           @relation(fields: [studentId], references: [id])
  status        String            @default("PRESENT") // PRESENT | ABSENT | LATE | SICK | SICK_HOME | SICK_CLINIC | BUSY | EXCUSED
  excusedReason String? // why the learner is excused (required when EXCUSED - iEduPro parity)
  markedOffline Boolean           @default(false)
}

// ─────────────────────────────────────────────────────────────
// GRADEBOOK & REPORT CARDS
// ─────────────────────────────────────────────────────────────
model Assessment {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  termId      String
  term        Term      @relation(fields: [termId], references: [id])
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  title       String
  type        String // EXERCISE | HOMEWORK | PROJECT | QUIZ | GROUP_WORK | MID_TERM | END_OF_TERM
  maxScore    Int       @default(100)
  date        DateTime
  marks       Mark[]
}

model Mark {
  id             String     @id @default(cuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id])
  studentId      String
  student        Student    @relation(fields: [studentId], references: [id])
  score          Float?
  enteredOffline Boolean    @default(false)
}

model ReportCard {
  id            String             @id @default(cuid())
  studentId     String
  student       Student            @relation(fields: [studentId], references: [id])
  termId        String
  term          Term               @relation(fields: [termId], references: [id])
  classroomName String
  results       ReportCardResult[]
  totalScore    Float?
  average       Float?
  classPosition Int?
  classSize     Int?
  conduct       String? // A | B | C
  interest      String?
  attendance    String? // "Present 38 of 42 days"
  teacherRemark String?
  headRemark    String?
  aiGenerated   Boolean            @default(false)
  promotion     String? // PROMOTED | PROBATION | REPEAT
  published     Boolean            @default(false)
  publishedAt   DateTime?
  createdAt     DateTime           @default(now())
}

model ReportCardResult {
  id           String     @id @default(cuid())
  reportCardId String
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id])
  subjectName  String
  subjectCode  String? // WAEC BECE subject code (101 Mathematics, 102 English…)
  isCore       Boolean    @default(false) // core subjects drive the BECE aggregate
  classScore   Float?
  examScore    Float?
  total        Float?
  grade        String?
  remark       String?
  position     Int? // position in subject for the class (1st, 2nd…)
}

// Report card remarks library — iedupro parity
model RemarkTemplate {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  category   String // TEACHER_POSITIVE | TEACHER_NEUTRAL | TEACHER_NEGATIVE | HEAD_RANGE
  minPercent Int? // HEAD_RANGE: band floor
  maxPercent Int? // HEAD_RANGE: band ceiling
  text       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// Conduct traits & interests printed on report sheets — iedupro parity
model ConductItem {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])
  name      String
  kind      String // CONDUCT | INTEREST
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

// ─────────────────────────────────────────────────────────────
// CROSS-SCHOOL: FLAGS, TRANSFERS, RECORD REQUESTS, ADMISSIONS
// ─────────────────────────────────────────────────────────────
model StudentFlag {
  id              String             @id @default(cuid())
  studentId       String
  student         Student            @relation(fields: [studentId], references: [id])
  schoolId        String
  school          School             @relation("FlagsRaised", fields: [schoolId], references: [id])
  raisedByName    String
  type            String // FEE_ARREARS | WITHDREW_OWING | DISCIPLINE_SUSPENSION | DISCIPLINE_EXPULSION | EXAM_MALPRACTICE | PROPERTY_UNRETURNED
  severity        String // LOW | MEDIUM | HIGH | CRITICAL
  status          String             @default("ACTIVE") // ACTIVE | RESOLVED | CONTESTED | WITHDRAWN
  amountOwedCents Int?
  description     String
  raisedAt        DateTime           @default(now())
  resolvedAt      DateTime?
  resolutionNote  String?
  resolvedByName  String?
  verifications   FlagVerification[]
}

model FlagVerification {
  id           String      @id @default(cuid())
  flagId       String
  flag         StudentFlag @relation(fields: [flagId], references: [id])
  officerName  String
  officerTitle String
  action       String // CONFIRMED | EVIDENCE_REQUESTED | DISMISSED
  note         String?
  verifiedAt   DateTime    @default(now())
}

model TransferRecord {
  id                String   @id @default(cuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  fromSchoolId      String
  fromSchool        School   @relation("TransfersFrom", fields: [fromSchoolId], references: [id])
  toSchoolId        String
  toSchool          School   @relation("TransfersTo", fields: [toSchoolId], references: [id])
  date              DateTime
  reason            String?
  outstandingCents  Int      @default(0)
  documentsReleased Boolean  @default(false)
  initiatedBy       String   @default("PARENT") // PARENT | SCHOOL
  status            String   @default("COMPLETED") // COMPLETED | PENDING_RELEASE | DECLINED
  notes             String?
}

model RecordRequest {
  id                 String           @id @default(cuid())
  studentId          String
  student            Student          @relation(fields: [studentId], references: [id])
  requestingSchoolId String
  requestingSchool   School           @relation("RequestsFrom", fields: [requestingSchoolId], references: [id])
  targetSchoolId     String
  targetSchool       School           @relation("RequestsTo", fields: [targetSchoolId], references: [id])
  requestedByName    String
  requestedAt        DateTime         @default(now())
  purpose            String           @default("ADMISSION") // ADMISSION | TRANSFER | VERIFICATION
  status             String           @default("PENDING") // PENDING | APPROVED | DECLINED | FULFILLED
  respondedAt        DateTime?
  respondedByName    String?
  notes              String?
  messages           RequestMessage[]
}

model RequestMessage {
  id          String        @id @default(cuid())
  requestId   String
  request     RecordRequest @relation(fields: [requestId], references: [id])
  senderName  String
  senderTitle String
  body        String
  sentAt      DateTime      @default(now())
}

model AdmissionInquiry {
  id                String    @id @default(cuid())
  schoolId          String
  school            School    @relation(fields: [schoolId], references: [id])
  studentName       String
  dateOfBirth       DateTime?
  gender            String?
  guardianName      String
  guardianPhone     String
  guardianEmail     String?
  classAppliedFor   String
  matchedStudentId  String?
  matchedStudent    Student?  @relation(fields: [matchedStudentId], references: [id])
  registryCheckedAt DateTime?
  registrySummary   String? // JSON snapshot
  status            String    @default("NEW") // NEW | MATCHED | FLAGGED | CLEARED | ENROLLED | DECLINED
  handledByName     String?
  notes             String?
  createdAt         DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// AI, RISK, ANNOUNCEMENTS
// ─────────────────────────────────────────────────────────────
model RiskScore {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  termId         String?
  score          Int // 0-100
  level          String // LOW | MODERATE | HIGH | CRITICAL
  factorsJson    String // JSON
  recommendation String?
  computedAt     DateTime @default(now())
}

model Announcement {
  id                String           @id @default(cuid())
  schoolId          String?
  school            School?          @relation(fields: [schoolId], references: [id])
  associationNodeId String?
  associationNode   AssociationNode? @relation(fields: [associationNodeId], references: [id])
  title             String
  body              String
  audience          String           @default("SCHOOLS") // SCHOOLS | PARENTS | ZONAL | DISTRICT | REGIONAL | NATIONAL
  category          String           @default("GENERAL") // GENERAL | COMPLIANCE | CALENDAR | URGENT | TRAINING
  priority          String           @default("NORMAL") // NORMAL | HIGH
  postedByName      String
  postedAt          DateTime         @default(now())
}

model AiChatMessage {
  id         String   @id @default(cuid())
  sessionKey String // user-scoped key
  role       String // user | assistant
  content    String
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// ONLINE EXAMS (iEduPro online_exam parity) — MCQ papers published to a
// class, attempted by learners, auto-marked against the answer key
// ─────────────────────────────────────────────────────────────
model OnlineExam {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  classroomId   String?
  classroom     Classroom? @relation(fields: [classroomId], references: [id])
  subjectName   String
  title         String
  description   String?
  durationMins  Int       @default(30)
  scheduledAt   DateTime?
  status        String    @default("DRAFT") // DRAFT | PUBLISHED | CLOSED
  createdByName String?
  createdAt     DateTime  @default(now())
  questions     OnlineExamQuestion[]
  attempts      OnlineExamAttempt[]
}

model OnlineExamQuestion {
  id            String   @id @default(cuid())
  examId        String
  exam          OnlineExam @relation(fields: [examId], references: [id])
  prompt        String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String   // A | B | C | D
  marks         Int      @default(1)
  sortOrder     Int      @default(0)
}

model OnlineExamAttempt {
  id          String   @id @default(cuid())
  examId      String
  exam        OnlineExam @relation(fields: [examId], references: [id])
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  answers     String // JSON { "0": "A", "1": "C", … } keyed by question sortOrder
  score       Int?
  submittedAt DateTime @default(now())

  @@unique([examId, studentId])
}

// ─────────────────────────────────────────────────────────────
// DAILY SERVICES (canteen, water, extra classes) — micro-billing
// ─────────────────────────────────────────────────────────────
model DailyService {
  id          String                   @id @default(cuid())
  schoolId    String
  school      School                   @relation(fields: [schoolId], references: [id])
  name        String // Lunch, Breakfast, Sachet Water, Extra Classes
  category    String // MEAL | DRINK | CLASS | CARE | TRANSPORT | OTHER
  priceCents  Int // standard school-wide rate (one-way fare for TRANSPORT — the per-trip charge)
  chargeMode  String                   @default("DAILY") // DAILY (every school day) | WEEKLY (once a week, first school day)
  weekdays    String                   @default("1,2,3,4,5") // ISO weekdays the service runs (e.g. "3" = Wednesdays only)
  active      Boolean                  @default(true)
  enrollments DailyServiceEnrollment[]
  charges     DailyCharge[]
  classRates  DailyServiceRate[]
  balances    ServiceBalance[]
}

// ── Per-classroom rate overrides (iedupro daily_fee_rates: rates are set per
//    class-section per fee type). Resolution: student override → class rate →
//    service standard price. ──
model DailyServiceRate {
  id          String        @id @default(cuid())
  serviceId   String
  service     DailyService  @relation(fields: [serviceId], references: [id])
  classroomId String
  classroom   Classroom    @relation(fields: [classroomId], references: [id])
  priceCents  Int

  @@unique([serviceId, classroomId])
}

model DailyServiceEnrollment {
  id                 String       @id @default(cuid())
  serviceId          String
  service            DailyService @relation(fields: [serviceId], references: [id])
  studentId          String
  student            Student      @relation(fields: [studentId], references: [id])
  priceCentsOverride Int? // subsidised rate per learner (e.g. needy-family support)
  active             Boolean      @default(true)
  enrolledAt         DateTime     @default(now())

  @@unique([serviceId, studentId])
}

model DailyCharge {
  id          String       @id @default(cuid())
  serviceId   String
  service     DailyService @relation(fields: [serviceId], references: [id])
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id])
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id])
  date        DateTime
  amountCents Int
  status      String       @default("OWED") // OWED | PAID | WAIVED
  usage       String?      // transport fare usage: MORNING | AFTERNOON | BOTH | NOT_USING | BOARDED (TRANSPORT-category services only)
  paymentId   String?
  payment     Payment?     @relation(fields: [paymentId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([serviceId, studentId, date]) // not unique: partial payments split a day-charge into PAID + remainder rows
}

// ── Daily-fee wallets (iedupro parity): prepaid balance for any daily service,
//    transport wallet reserved for bus fare. Arrears are derived from OWED charges.
model StudentWallet {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  studentId      String   @unique
  student        Student  @relation(fields: [studentId], references: [id])
  prepaidCents   Int      @default(0)
  transportCents Int      @default(0)
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([schoolId])
}

model WalletTxn {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  wallet       String // GENERAL | PREPAID | TRANSPORT | ITEM (per-service balance; see serviceId)
  kind         String // TOPUP | PAY | ADJUST
  amountCents  Int // signed: + credit, − debit
  balanceAfter Int
  note         String?
  byName       String?
  serviceId    String? // set when wallet = ITEM — the daily-service item the txn moved
  at           DateTime @default(now())

  @@index([schoolId, studentId])
}

// Per-item prepaid balances (iEduPro daily_fee_wallet parity — each fee item
// carries its own prepaid credit; charges auto-deduct from it, excess payments
// land back on it as advance). The general StudentWallet.prepaidCents remains
// a flexible any-item credit line.
model ServiceBalance {
  id           String        @id @default(cuid())
  schoolId     String
  school       School        @relation(fields: [schoolId], references: [id])
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id])
  serviceId    String
  service      DailyService  @relation(fields: [serviceId], references: [id])
  prepaidCents Int           @default(0)
  updatedAt    DateTime      @default(now()) @updatedAt

  @@unique([studentId, serviceId])
  @@index([schoolId])
}

// ─────────────────────────────────────────────────────────────
// TRANSPORTATION (routes, vehicles, assignments, trips)
// ─────────────────────────────────────────────────────────────
model TransportRoute {
  id               String                @id @default(cuid())
  schoolId         String
  school           School                @relation(fields: [schoolId], references: [id])
  name             String // "Adenta Loop"
  vehicleReg       String // "GR 4521-21"
  vehicleModel     String?
  driverName       String
  driverPhone      String
  capacity         Int                   @default(15)
  farePerTermCents Int
  farePerTripCents Int                   @default(0) // one-way fare (×2 for BOTH directions)
  stops            String // comma-separated stop names
  active           Boolean               @default(true)
  assignments      TransportAssignment[]
  trips            TransportTrip[]
  stopRecords      TransportStop[]
  boardings        TransportBoarding[]
}

// Structured stops with per-stop fare overrides — iedupro parity
model TransportStop {
  id        String         @id @default(cuid())
  routeId   String
  route     TransportRoute @relation(fields: [routeId], references: [id])
  name      String
  fareCents Int? // null = route default fare
  sortOrder Int            @default(0)
}

// Vehicle registry with statutory expiry tracking — iedupro parity
model Vehicle {
  id               String    @id @default(cuid())
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id])
  regNumber        String    @unique
  model            String?
  capacity         Int       @default(15)
  insuranceExpiry  DateTime?
  roadworthyExpiry DateTime?
  status           String    @default("ACTIVE") // ACTIVE | MAINTENANCE | RETIRED
  notes            String?
  createdAt        DateTime  @default(now())
}

// Driver registry (staff-linked or standalone) — iedupro parity
model DriverRecord {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  name          String
  phone         String?
  licenseNo     String?
  licenseExpiry DateTime?
  staffId       String? // optional link to a Staff record
  status        String    @default("ACTIVE") // ACTIVE | SUSPENDED | RETIRED
  createdAt     DateTime  @default(now())
}

// Daily boarding records (morning collection) — direction-based fares
model TransportBoarding {
  id             String              @id @default(cuid())
  assignmentId   String
  assignment     TransportAssignment @relation(fields: [assignmentId], references: [id])
  routeId        String
  route          TransportRoute      @relation(fields: [routeId], references: [id])
  date           DateTime
  direction      String              @default("NONE") // IN | OUT | BOTH | NONE
  fareCents      Int                 @default(0) // 1× trip fare (×2 for BOTH)
  paidCents      Int                 @default(0)
  recordedByName String?
  createdAt      DateTime            @default(now())

  @@unique([assignmentId, date])
}

model TransportAssignment {
  id                 String              @id @default(cuid())
  routeId            String
  route              TransportRoute      @relation(fields: [routeId], references: [id])
  studentId          String
  student            Student             @relation(fields: [studentId], references: [id])
  pickupStop         String?
  dropStop           String?
  fareOverrideCents  Int? // per-term override (e.g. half-route rate)
  active             Boolean             @default(true)
  enrolledAt         DateTime            @default(now())
  transportBoardings TransportBoarding[]

  @@unique([routeId, studentId])
}

model TransportTrip {
  id             String         @id @default(cuid())
  routeId        String
  route          TransportRoute @relation(fields: [routeId], references: [id])
  date           DateTime
  morningCount   Int?
  eveningCount   Int?
  notes          String?
  recordedByName String?

  @@unique([routeId, date])
}

// ─────────────────────────────────────────────────────────────
// SMS ALERTS (gateway-agnostic: Arkesel / Termii / simulated)
// ─────────────────────────────────────────────────────────────
model SmsSetting {
  id                  String  @id @default(cuid())
  schoolId            String  @unique
  school              School  @relation(fields: [schoolId], references: [id])
  provider            String  @default("SIMULATED") // SIMULATED | ARKESEL | TERMII
  senderId            String  @default("NYANSAPO")
  credits             Int     @default(500)
  autoFeeReminders      Boolean @default(true)
  autoAbsenceAlerts     Boolean @default(true)
  autoPaymentReceipts   Boolean @default(true)
  autoLessonNoteAlerts  Boolean @default(true) // teacher SMS when a GES note is returned / endorsed
}

model SmsTemplate {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])
  name      String
  category  String // FEES | ATTENDANCE | RESULTS | ANNOUNCEMENT | PAYMENT | TRANSPORT | GENERAL
  body      String // supports {student} {school} {amount} {balance} {class} {date} placeholders
  isDefault Boolean @default(false)
}

// Event-driven SMS automations — iedupro parity
model SmsAutomation {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  name       String
  trigger    String // PAYMENT_RECEIVED | INVOICE_ISSUED | ABSENCE_MARKED | RESULTS_PUBLISHED | BILL_REMINDER
  recipients String    @default("GUARDIANS") // GUARDIANS | TEACHERS | ALL
  body       String // placeholders {student} {amount} {balance} {date} {school} {class}
  offsetDays Int       @default(0) // negative = days after event
  active     Boolean   @default(true)
  lastRunAt  DateTime?
  sentCount  Int       @default(0)
  createdAt  DateTime  @default(now())
}

model SmsMessage {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  studentId      String?
  student        Student? @relation(fields: [studentId], references: [id])
  recipientName  String
  recipientPhone String
  body           String
  category       String
  status         String   @default("SENT") // QUEUED | SENT | DELIVERED | FAILED
  creditsUsed    Int      @default(1)
  sentByName     String?
  sentAt         DateTime @default(now())
  errorReason    String?
  provider       String? // gateway that carried the message (SIMULATED | ARKESEL | TERMII)
  providerRef    String? // gateway message id, for delivery follow-up
}

// ─────────────────────────────────────────────────────────────
// MEDIA ASSETS — blob storage for portraits & branding uploads.
// Binary bytes live here (fetched only via /api/media/[id] with lazy
// loading + immutable caching) instead of bloating Student/SchoolSetting
// rows with base64 data-URLs. Swap to S3 later by changing storeMedia
// + the GET route only.
// ─────────────────────────────────────────────────────────────
model MediaAsset {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  kind      String // PORTRAIT | LOGO | SIGNATURE
  mimeType  String // image/png | image/jpeg | image/webp
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// PAYROLL (Ghana: SSNIT Tier 1/2 + PAYE progressive tax)
// ─────────────────────────────────────────────────────────────
model PayrollRun {
  id                      String    @id @default(cuid())
  schoolId                String
  school                  School    @relation(fields: [schoolId], references: [id])
  period                  String // "2026-10"
  status                  String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | PAID
  payslips                Payslip[]
  totalGrossCents         Int       @default(0)
  totalDeductionsCents    Int       @default(0)
  totalNetCents           Int       @default(0)
  totalEmployerSsnitCents Int       @default(0)
  approvedByName          String?
  paidAt                  DateTime?
  createdAt               DateTime  @default(now())

  @@unique([schoolId, period])
}

model Payslip {
  id                   String     @id @default(cuid())
  payrollRunId         String
  payrollRun           PayrollRun @relation(fields: [payrollRunId], references: [id])
  staffId              String
  staff                Staff      @relation(fields: [staffId], references: [id])
  baseSalaryCents      Int
  allowancesJson       String     @default("[]") // [{name, amountCents}]
  grossCents           Int
  ssnitEmployeeCents   Int // 5% Tier 1
  ssnitEmployerCents   Int // 13% Tier 1 + 5% Tier 2
  payeCents            Int
  otherDeductionsJson  String     @default("[]") // [{name, amountCents}]
  totalDeductionsCents Int
  netCents             Int
  status               String     @default("PENDING") // PENDING | PAID
  reference            String? // payslip reference no e.g. PS-2026/10/0142
  workingDays          Int? // attendance proration
  daysPresent          Int?
  paidAt               DateTime?

  @@unique([payrollRunId, staffId])
}

// Tier-2 pension providers (occupational pension trusts) — iedupro parity
model PensionProvider {
  id           String  @id @default(cuid())
  schoolId     String
  school       School  @relation(fields: [schoolId], references: [id])
  name         String
  code         String  @unique
  contactPhone String?
  active       Boolean @default(true)
}

// ─────────────────────────────────────────────────────────────
// INVENTORY (books, uniforms, stationery, food supplies)
// ─────────────────────────────────────────────────────────────
model InventoryItem {
  id             String          @id @default(cuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id])
  name           String
  sku            String?
  category       String // BOOKS | UNIFORMS | STATIONERY | FOOD | CLEANING | FUEL | OTHER
  unit           String          @default("pcs")
  unitCostCents  Int             @default(0)
  sellPriceCents Int? // null = internal use only
  stockQty       Int             @default(0)
  reorderLevel   Int             @default(10)
  location       String?
  movements      StockMovement[]
}

model StockMovement {
  id               String        @id @default(cuid())
  itemId           String
  item             InventoryItem @relation(fields: [itemId], references: [id])
  schoolId         String
  school           School        @relation(fields: [schoolId], references: [id])
  type             String // PURCHASE | ISSUE | RETURN | ADJUST
  qty              Int // signed: + in, - out
  unitCostCents    Int?
  partyType        String? // SUPPLIER | STUDENT | STAFF | CLASS | SALE
  partyName        String?
  studentId        String?
  student          Student?      @relation(fields: [studentId], references: [id])
  chargedToInvoice Boolean       @default(false)
  note             String?
  saleNo           String? // groups the lines of one counter sale (POS)
  amountCents      Int? // line total for counter sales (qty × sell price)
  createdAt        DateTime      @default(now())
}

model Supplier {
  id             String          @id @default(cuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id])
  name           String
  phone          String?
  email          String?
  itemsSupplied  String?
  notes          String?
  purchaseOrders PurchaseOrder[]
}

// ─────────────────────────────────────────────────────────────
// DISCOUNTS (scholarships, siblings, needy support — invoice & daily)
// ─────────────────────────────────────────────────────────────
model Discount {
  id           String                @id @default(cuid())
  schoolId     String
  school       School                @relation(fields: [schoolId], references: [id])
  name         String // "Sibling Discount 10%"
  type         String // PERCENT | FIXED
  value        Int // percent (0-100) or pesewas
  scope        String                @default("INVOICE") // INVOICE | DAILY_SERVICE
  autoApply    Boolean               @default(false) // applied automatically at invoice generation
  active       Boolean               @default(true)
  notes        String?
  createdAt    DateTime              @default(now())
  applications DiscountApplication[]
}

// Discount profiles: named rule-sets assigned to classes / fee items — iedupro parity.
// For DAILY_SERVICE profiles `serviceIds` scopes the subsidy: "*" = every daily
// service, or a comma-separated list of DailyService ids — e.g. lunch-only
// (part or full), extra-classes-only, or "lunch + breakfast".
model DiscountProfile {
  id           String                @id @default(cuid())
  schoolId     String
  school       School                @relation(fields: [schoolId], references: [id])
  name         String
  category     String                @default("INVOICE") // INVOICE | DAILY_SERVICE
  method       String                @default("PERCENT") // PERCENT | FIXED
  value        Int // percent or pesewas
  feeItemName  String                @default("*") // "*" = all fee items, otherwise exact item name
  serviceIds   String                @default("*") // DAILY_SERVICE scope: "*" = all services, else csv of DailyService ids
  description  String?
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  rules        DiscountRule[]
  applications DiscountApplication[]

  @@unique([schoolId, name])
}

// Per-class / per-fee-item overrides inside a profile
model DiscountRule {
  id            String          @id @default(cuid())
  profileId     String
  profile       DiscountProfile @relation(fields: [profileId], references: [id])
  classroomName String? // null = all classes
  feeItemName   String? // null = profile default
  value         Int // percent or pesewas override
}

model DiscountApplication {
  id             String           @id @default(cuid())
  discountId     String?
  discount       Discount?        @relation(fields: [discountId], references: [id])
  profileId      String?
  profile        DiscountProfile? @relation(fields: [profileId], references: [id])
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id])
  serviceId      String? // for DAILY_SERVICE scope: which service gets the subsidised rate
  valueOverride  Int? // per-application override of the discount value
  status         String           @default("PENDING") // PENDING | APPROVED | REJECTED | REVOKED | EXPIRED
  validFrom      DateTime?
  validTo        DateTime?
  reason         String?
  appliedByName  String
  approvedByName String?
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())
}

// ─────────────────────────────────────────────────────────────
// EXPENDITURE (school expenses by category)
// ─────────────────────────────────────────────────────────────
model Expense {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  category       String // UTILITIES | SALARIES | MAINTENANCE | TRANSPORT_FUEL | TEACHING_MATERIALS | EVENTS | ADMIN | OTHER
  description    String
  amountCents    Int
  method         String   @default("CASH") // CASH | MOMO_MTN | MOMO_TELECEL | MOMO_AT | BANK | CHEQUE
  expenseDate    DateTime @default(now())
  recordedByName String?
  createdAt      DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// PURCHASE ORDERS (inventory restocking)
// ─────────────────────────────────────────────────────────────
model PurchaseOrder {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  poNo          String    @unique
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  linesJson     String    @default("[]") // [{itemId, name, qty, unitCostCents}]
  totalCents    Int       @default(0)
  status        String    @default("PENDING") // PENDING | RECEIVED | CANCELLED
  expectedDate  DateTime?
  receivedAt    DateTime?
  createdByName String?
  note          String?
  createdAt     DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// LIBRARY (librarian portal) — catalogue & circulation
// ─────────────────────────────────────────────────────────────
model LibraryBook {
  id          String        @id @default(cuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id])
  title       String
  author      String?
  isbn        String?
  category    String        @default("General") // Storybook | Textbook | Reference | Fiction | Science | History ...
  copies      Int           @default(1)
  available   Int           @default(1) // denormalised: copies − active loans
  shelf       String? // location e.g. "Shelf B-3"
  createdAt   DateTime      @default(now())
  loans       LibraryLoan[]
  requests    BookRequest[]
}

model LibraryLoan {
  id             String       @id @default(cuid())
  bookId         String
  book           LibraryBook  @relation(fields: [bookId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  issuedAt       DateTime     @default(now())
  dueAt          DateTime
  returnedAt     DateTime?
  issuedByName   String?
  conditionNote  String? // condition on issue / return
}

// ─────────────────────────────────────────────────────────────
// OPS SETTINGS (key-value: statutory rates, numbering, etc.)
// ─────────────────────────────────────────────────────────────
model OpsSetting {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  key       String // e.g. SSNIT_TIER1_RATE
  value     String
  updatedAt DateTime @default(now())

  @@unique([schoolId, key])
}

// ─────────────────────────────────────────────────────────────
// BOARDING (iEduPro boarding_system parity — houses / dormitories / beds)
// ─────────────────────────────────────────────────────────────
model BoardingHouse {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id])
  name            String
  description     String?
  houseMasterId   String? // staff — house master / warden
  houseMaster     Staff?   @relation("HouseMaster", fields: [houseMasterId], references: [id])
  prefectId       String? // learner — house prefect
  prefect         Student? @relation("HousePrefect", fields: [prefectId], references: [id])
  capacity        Int       @default(0)
  yearEstablished String?
  gpsCode         String?
  termlyFeeCents  Int       @default(0)
  status          String    @default("AVAILABLE") // AVAILABLE | ASSIGNED | MAINTENANCE
  dormitories     Dormitory[]
  createdAt       DateTime  @default(now())
}

model Dormitory {
  id          String        @id @default(cuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id])
  houseId     String
  house       BoardingHouse @relation(fields: [houseId], references: [id])
  name        String
  capacity    Int           @default(0)
  type        String? // Male | Female
  floor       String?
  description String?
  prefectId   String? // learner — dormitory prefect
  prefect     Student?      @relation("DormitoryPrefect", fields: [prefectId], references: [id])
  status      String        @default("AVAILABLE") // AVAILABLE | ASSIGNED | MAINTENANCE
  beds        Bed[]
  createdAt   DateTime      @default(now())
}

model Bed {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  dormitoryId String
  dormitory   Dormitory @relation(fields: [dormitoryId], references: [id])
  code        String // e.g. AGY-014
  bedType     String    @default("SINGLE") // SINGLE | BUNK
  status      String    @default("AVAILABLE") // AVAILABLE | ASSIGNED | MAINTENANCE
  studentId   String?   @unique // currently assigned boarder (one-to-one)
  student     Student?  @relation("BedOccupant", fields: [studentId], references: [id])
  assignedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([schoolId, code])
}

// ─────────────────────────────────────────────────────────────
// LIBRARY BOOK REQUESTS (student/parent portal → librarian queue)
// ─────────────────────────────────────────────────────────────
model BookRequest {
  id             String      @id @default(cuid())
  schoolId       String
  school         School      @relation(fields: [schoolId], references: [id])
  bookId         String
  book           LibraryBook @relation(fields: [bookId], references: [id])
  studentId      String
  student        Student     @relation(fields: [studentId], references: [id])
  startAt        DateTime // requested issue date
  endAt          DateTime // requested return date
  status         String      @default("PENDING") // PENDING | ISSUED | REJECTED
  handledAt      DateTime?
  handledByName  String?
  loanId         String? // the LibraryLoan created on accept
  createdAt      DateTime    @default(now())
}

// ─────────────────────────────────────────────────────────────
// QUESTION PAPER BANK (iEduPro question_paper parity)
// ─────────────────────────────────────────────────────────────
model QuestionPaper {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  title       String
  body        String // rich text (HTML) — the paper itself
  examName    String? // e.g. "End of Term 1 Examination 2026/27"
  authorName  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────
// RECEIPT / INVOICE MODIFICATION-APPROVAL QUEUE (iEduPro parity)
// cashiers request an edit/delete; super admin approves, rejects or revokes
// ─────────────────────────────────────────────────────────────
model ModificationRequest {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id])
  targetType      String // PAYMENT | INVOICE
  recordId        String
  recordCode      String // receipt no / invoice no
  requestType     String // EDIT | DELETE
  reason          String
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | REVOKED
  requestedById   String
  requestedByName String
  originalData    String? // JSON snapshot of the record at request time
  newData         String? // JSON of the proposed replacement (EDiT)
  handledById     String?
  handledByName   String?
  handledAt       DateTime?
  decisionNote    String?
  createdAt       DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// WAEC RAW-SCORE GRADING (BECE/WASSCE scale — editable per school)
// ─────────────────────────────────────────────────────────────
model RawScoreGrade {
  id                String  @id @default(cuid())
  schoolId          String
  school            School  @relation(fields: [schoolId], references: [id])
  name              String // remark word: EXCELLENT / VERY GOOD / CREDIT / PASS / FAIL
  gradePoint        String // A1 … F9 (or 1–9)
  gradePointNumeric Float   @default(0) // BECE aggregate weight
  markFrom          Float
  markUpto          Float
  comment           String?
  sortOrder         Int     @default(0)
}

// ─────────────────────────────────────────────────────────────
// PORTFOLIO ASSESSMENT (GES weekly SBA — strand scores feed class score)
// ─────────────────────────────────────────────────────────────
model PortfolioEntry {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  classroomId String
  subjectId   String
  subjectName String
  week        String // ISO week "2026-W44"
  entryDate   DateTime // the school day (Mon–Fri)
  strandCode  String? // curriculum strand / sub-strand code e.g. "B4.1.2.1"
  score       Float    @default(0) // 0–10 daily strand score
  createdAt   DateTime @default(now())

  @@unique([studentId, subjectId, entryDate])
}

// ─────────────────────────────────────────────────────────────
// DAILY-FEE PER-CHARGE AUDIT LOG (iEduPro daily_fee_audit_log parity)
// ─────────────────────────────────────────────────────────────
model DailyFeeAudit {
  id                 String   @id @default(cuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id])
  actionType         String // CHARGE | CHARGE_REVERSAL | PAYMENT | PAYMENT_REVERSAL | TOPUP | ADJUSTMENT | RECONCILIATION
  serviceCode        String // FEEDING | BREAKFAST | CLASSES | WATER | TRANSPORT | MULTIPLE
  amountCents        Int      @default(0)
  balanceBeforeCents Int      @default(0)
  balanceAfterCents  Int      @default(0)
  arrearsBeforeCents Int      @default(0)
  arrearsAfterCents  Int      @default(0)
  performedByName    String
  performedByRole    String
  reference          String? // receipt no / charge id
  notes              String?
  createdAt          DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// CASHIER HANDOVER REPORTS (signed daily float handover)
// ─────────────────────────────────────────────────────────────
model HandoverReport {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  date          DateTime
  cashierId     String
  cashierName   String
  receiverId    String
  receiverName  String
  totalCents    Int      @default(0)
  cashCents     Int      @default(0)
  createdAt     DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// CURRICULUM & LESSON NOTES (iEduPro lesson-note lifecycle parity:
// templates → teacher weekly notes → HOD/admin review → endorse /
// request revision → progress & compliance; plus study material
// sharing and the week-by-week scheme of learning)
// ─────────────────────────────────────────────────────────────
model LessonNoteTemplate {
  id              String     @id @default(cuid())
  schoolId        String
  school          School     @relation(fields: [schoolId], references: [id])
  subjectId       String?
  subject         Subject?   @relation(fields: [subjectId], references: [id])
  classroomId     String? // null = any class studying the subject
  classroom       Classroom? @relation(fields: [classroomId], references: [id])
  name            String
  strand          String?
  subStrand       String?
  contentStandard String?
  description     String?
  objectives      String     @default("")
  activities      String     @default("")
  content         String     @default("")
  createdAt       DateTime   @default(now())
}

model LessonNote {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id])
  staffId         String
  staff           Staff     @relation(fields: [staffId], references: [id])
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id])
  subjectId       String
  subject         Subject   @relation(fields: [subjectId], references: [id])
  termId          String
  term            Term      @relation(fields: [termId], references: [id])
  templateId      String? // seeded from a LessonNoteTemplate
  title           String
  description     String?
  weekNumber      Int // 1..15 within the term
  lessonDate      DateTime
  objectives      String    @default("")
  activities      String    @default("")
  content         String    @default("")
  status          String    @default("PENDING") // DRAFT | PENDING | ENDORSED | REVISION_REQUIRED
  feedback        String? // reviewer comment accompanying a revision request
  version         Int       @default(1)
  sourceNoteId    String? // copied from a previous note
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedByName  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reviews         LessonNoteReview[]

  @@unique([staffId, classroomId, subjectId, termId, weekNumber])
}

model LessonNoteReview {
  id        String     @id @default(cuid())
  noteId    String
  note      LessonNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  action    String // CREATE | UPDATE | SUBMIT | ENDORSE | REQUEST_REVISION | RESUBMIT
  actorName String
  comment   String?
  createdAt DateTime   @default(now())
}

model StudyMaterial {
  id            String     @id @default(cuid())
  schoolId      String
  school        School     @relation(fields: [schoolId], references: [id])
  classroomId   String
  classroom     Classroom  @relation(fields: [classroomId], references: [id])
  subjectId     String?
  subject       Subject?   @relation(fields: [subjectId], references: [id])
  title         String
  description   String?
  linkUrl       String? // external resource / shared-drive link
  body          String? // inline notes & instructions
  authorStaffId String
  author        Staff      @relation(fields: [authorStaffId], references: [id])
  createdAt     DateTime   @default(now())
}

model SyllabusTopic {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id])
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id])
  subjectId       String
  subject         Subject   @relation(fields: [subjectId], references: [id])
  termId          String
  term            Term      @relation(fields: [termId], references: [id])
  weekNumber      Int // 1..15 — week of the term this topic is taught
  strand          String?
  subStrand       String?
  contentStandard String?
  indicator       String?
  topic           String
  completed       Boolean   @default(false)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([classroomId, subjectId, termId, weekNumber, topic])
}

// ─────────────────────────────────────────────────────────────
// SYNC-SAFE CODE ALLOCATION
// Human-readable codes (INV-YYYY-NNNN, RCP-YYYY-NNNNN, NY-YYYY-NNNNNN)
// are minted from atomic monotonic counters — never from row counts or
// read-then-write max() lookups. This makes online/offline and
// multi-device code generation conflict-free: the counter row is the
// single source of truth, updated with an atomic SQL increment.
// `next` stores the LAST allocated number for the scope.
// ─────────────────────────────────────────────────────────────
model CodeCounter {
  scope     String   @id // e.g. "INV:2026" | "RCP:2026" | "NYIDX:2016"
  next      Int      @default(0) // last allocated sequence number
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// STUDENT CREDITS (invoice-scope prepaid balances from overpayment)
// iEduPro parity: overpaying an invoice creates credit that is
// auto-applied to the next bill ("LESS: Prepaid Credit Applied"),
// transferable between learners and to daily-fee wallets.
// Ledger design mirrors WalletTxn: signed amounts + balanceAfter.
// ─────────────────────────────────────────────────────────────
model StudentCredit {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id])
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id])
  kind            String // CREDIT (overpayment/manual/refund-in/transfer-in) | APPLY (to invoice) | TRANSFER_OUT | TRANSFER_IN | DAILY_WALLET | ADJUST
  amountCents     Int // signed: + adds credit, - consumes it
  balanceAfter    Int
  invoiceId       String? // set when kind = APPLY
  sourcePaymentId String? // receipt that created an OVERPAYMENT credit
  note            String?
  byName          String?
  at              DateTime  @default(now())

  @@index([schoolId, studentId])
  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────
// CRECHE / EARLY-YEARS ASSESSMENT (iEduPro parity)
// GES early-childhood reporting: developmental domains, each with
// skills rated on a school-defined abbreviation scale (EX/GD/SD/NA),
// plus ordinary numeric subjects ("no category") for written exams.
// ─────────────────────────────────────────────────────────────
model CrecheDomain {
  id        String         @id @default(cuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id])
  name      String // e.g. "Communication & Language", "Motor Skills"
  sortOrder Int            @default(0)
  active    Boolean        @default(true)
  skills    CrecheSkill[]
}

model CrecheSkill {
  id        String         @id @default(cuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id])
  domainId  String
  domain    CrecheDomain   @relation(fields: [domainId], references: [id])
  name      String // observable skill / indicator
  sortOrder Int            @default(0)
  ratings   CrecheRating[]
}

model CrecheRating {
  id        String      @id @default(cuid())
  schoolId  String
  school    School      @relation(fields: [schoolId], references: [id])
  studentId String
  student   Student     @relation(fields: [studentId], references: [id])
  termId    String
  skillId   String
  skill     CrecheSkill @relation(fields: [skillId], references: [id])
  code      String // scale abbreviation (EX | GD | SD | NA...)
  byName    String?
  at        DateTime    @default(now())

  @@unique([studentId, termId, skillId])
  @@index([schoolId, termId])
}

model CrecheRatingScale {
  id        String @id @default(cuid())
  schoolId  String
  school    School @relation(fields: [schoolId], references: [id])
  code      String // EX
  label     String // Excellent
  sortOrder Int    @default(0)

  @@unique([schoolId, code])
}

// ─────────────────────────────────────────────────────────────
// SCHOOL SETTINGS KV (system_settings_modern parity)
// Simple typed key-value store for runtime configuration:
// SBA column maxes, receipt style, code formats, term runtime, etc.
// Values are stored as JSON strings.
// ─────────────────────────────────────────────────────────────
model SchoolSetting {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  key      String // e.g. "sba.classTestMax" | "receipts.style" | "term.daysOpened"
  value    String // JSON-encoded

  @@unique([schoolId, key])
}
