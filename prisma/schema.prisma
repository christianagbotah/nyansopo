// ─────────────────────────────────────────────────────────────
// CURRICULUM FRAMEWORK LIBRARY (NaCCA GES SBC/CCP · Cambridge CAIE · IB PYP)
// A shared, deduplicated library: strands → sub-strands → content standards
// → learning indicators, keyed by curriculum + subject name + grade level.
// International schools running several curricula (e.g. GES + Cambridge)
// pick the framework matching each subject/lesson — no data duplication.
model CurriculumStrand {
  id          String                @id @default(cuid())
  curriculum  String // GES | CAIE | IB
  subjectName String // matched case-insensitively against Subject.name
  gradeLevel  String // "B4" · "B7" · "Stage 4" · "PYP 4" — matches Classroom.gradeLevel
  code        String? // e.g. "B4.1" — NaCCA reference number
  name        String // "Number" · "Oral Language" · "Who we are"
  sortOrder   Int                   @default(0)
  subStrands  CurriculumSubStrand[]
  lessonNotes LessonNote[]          @relation("NoteStrand")

  @@unique([curriculum, subjectName, gradeLevel, name])
  @@index([curriculum, subjectName, gradeLevel])
}

model CurriculumSubStrand {
  id          String                      @id @default(cuid())
  strandId    String
  strand      CurriculumStrand            @relation(fields: [strandId], references: [id], onDelete: Cascade)
  code        String? // e.g. "B4.1.1"
  name        String // "Counting, Representation, Cardinality & Ordinality"
  sortOrder   Int                         @default(0)
  standards   CurriculumContentStandard[]
  lessonNotes LessonNote[]                @relation("NoteSubStrand")

  @@unique([strandId, name])
}

model CurriculumContentStandard {
  id          String                @id @default(cuid())
  subStrandId String
  subStrand   CurriculumSubStrand   @relation(fields: [subStrandId], references: [id], onDelete: Cascade)
  code        String? // e.g. "B4.1.1.1"
  statement   String // "Demonstrate understanding of quantities and place value…"
  indicators  CurriculumIndicator[]
  lessonNotes LessonNote[]          @relation("NoteStandard")

  @@unique([subStrandId, statement])
}

model CurriculumIndicator {
  id         String                    @id @default(cuid())
  standardId String
  standard   CurriculumContentStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  code       String? // e.g. "B4.1.1.1.1"
  statement  String // "Model number quantities, place value for multi-digit…"
  sortOrder  Int                       @default(0)

  @@unique([standardId, statement])
}

// ─────────────────────────────────────────────────────────────
// ACADEMIC CALENDAR
// ─────────────────────────────────────────────────────────────
model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String // "2026/2027"
  isCurrent Boolean  @default(false)
  startsAt  DateTime
  endsAt    DateTime
  terms     Term[]
}

model Term {
  id                 String              @id @default(cuid())
  academicYearId     String
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])
  name               String // First Term | Second Term | Third Term
  sequence           Int
  startsAt           DateTime
  endsAt             DateTime
  isCurrent          Boolean             @default(false)
  closedAt           DateTime? // wave 76 — stamped by the term-closing wizard when the head closes the term
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  assessments        Assessment[]
  attendanceSessions AttendanceSession[]
  reportCards        ReportCard[]
  beneficiaries     Beneficiary[]
  lessonNotes        LessonNote[]
  syllabusTopics     SyllabusTopic[]
  resultApprovals    ResultApproval[]
  termResults        TermResult[]
  schoolEvents       SchoolEvent[]
  homeworkItems      Homework[]
}

// ─────────────────────────────────────────────────────────────
// CLASSES, SUBJECTS, STAFF
// ─────────────────────────────────────────────────────────────
model Classroom {
  id                  String               @id @default(cuid())
  schoolId            String
  school              School               @relation(fields: [schoolId], references: [id])
  name                String // "Basic 4 Gold"
  gradeLevel          String // KG1..B9 | Year 1..13 | PYP 1..MYP 4
  stageLabel          String? // "Primary (SBC)" | "Cambridge Lower Secondary" | "IB MYP"
  capacity            Int                  @default(30)
  classTeacherId      String?
  classTeacher        Staff?               @relation(fields: [classTeacherId], references: [id])
  enrollments         Enrollment[]
  feeStructures       FeeStructure[]
  assessments         Assessment[]
  attendanceSessions  AttendanceSession[]
  timetableSlots      TimetableSlot[]
  dailyServiceRates   DailyServiceRate[]
  onlineExams         OnlineExam[]
  questionPapers      QuestionPaper[]
  lessonNoteTemplates LessonNoteTemplate[]
  lessonNotes         LessonNote[]
  studyMaterials      StudyMaterial[]
  syllabusTopics      SyllabusTopic[]
  resultApprovals     ResultApproval[]
  sections            Section[]
  termResults         TermResult[]
  homeworkItems       Homework[]
  examTimetableEntries ExamTimetableEntry[]
}

// Section (stream) within a classroom — iEduPro parity: a class like
// "Basic 4" can run multiple sections (Gold / Green, or A / B), each with
// its own ordered placement within the class.
model Section {
  id          String       @id @default(cuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id])
  classroomId String
  classroom   Classroom    @relation(fields: [classroomId], references: [id])
  name        String // "Gold" | "A" | "B" — shown as `Class name — Section`
  sortOrder   Int          @default(0) // ordered within the classroom (CI3 section ordering)
  capacity    Int?
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]

  @@unique([classroomId, name])
  @@index([schoolId])
}

model Subject {
  id                  String               @id @default(cuid())
  schoolId            String
  school              School               @relation(fields: [schoolId], references: [id])
  name                String
  code                String
  curriculum          String?
  isCore              Boolean              @default(true)
  assessments         Assessment[]
  timetableSlots      TimetableSlot[]
  lessonNoteTemplates LessonNoteTemplate[]
  lessonNotes         LessonNote[]
  studyMaterials      StudyMaterial[]
  syllabusTopics      SyllabusTopic[]
  termResults         TermResult[]
  homeworkItems       Homework[]
}

model Staff {
  id             String            @id @default(cuid())
  schoolId       String
  school         School            @relation(fields: [schoolId], references: [id])
  fullName       String
  role           String // HEADTEACHER | TEACHER | ACCOUNTANT | ASSISTANT | BURSAR
  title          String?
  email          String?
  phone          String?
  subjects       String? // comma-separated
  // staff category & position (iedupro parity: teacher / non-teaching / administrator)
  category       String            @default("TEACHING") // TEACHING | NON_TEACHING | ADMINISTRATION
  position       String? // e.g. Driver, Cook, Librarian, Security Guard, IT Technician
  qualification  String? // highest qualification / designation
  department     String? // Maintenance / Kitchen / Security / Transport ...
  staffCode      String? // TCR-00001 / NTS-00001 style identifier
  // payroll
  salaryCents    Int               @default(0) // basic monthly salary
  employmentType String            @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT | CASUAL
  ssnitNumber    String?
  tin            String?
  tier2Provider  String? // licensed Tier 2 pension manager (e.g. Petra Trust)
  tier2MemberId  String? // tier-2 membership number with the provider
  ghanaCardId    String? // Ghana Card number (GHA-XXXXXXXXX-X)
  birthday       DateTime?
  sex            String? // M | F
  address        String?
  accountNumber  String? // bank / momo account (masked in UI)
  momoNumber     String?
  bankName       String?
  hiredAt        DateTime?
  // SMS notification preference (iedupro user_notification_preferences parity):
  // per-teacher opt-out for lesson-note return/endorse alerts; school-level kill
  // switch lives on SmsSetting.autoLessonNoteAlerts
  smsNotify      Boolean           @default(true)
  active         Boolean           @default(true)
  // CI3 teacher.show_on_website parity — appears on the public school website staff page
  showOnWebsite  Boolean           @default(false)
  // NTC licensure (wave 58 — Ghana National Teaching Council): teaching staff
  // hold a renewable licence; CPD points accrue over the licence cycle
  ntcLicenceNo    String? // NTC licence number
  ntcCategory     String? // Professional | Provisional | Non-professional
  ntcIssued       DateTime?
  ntcExpiry       DateTime?
  classrooms     Classroom[]
  payslips       Payslip[]
  timetableSlots TimetableSlot[]
  users          User[]            @relation("UserStaff")
  housesMastered BoardingHouse[]   @relation("HouseMaster")
  lessonNotes    LessonNote[]
  studyMaterials StudyMaterial[]
  attendanceRows StaffAttendance[]
  leaveRequests  LeaveRequest[]
  dutySlots      DutyAssignment[]
  movements      StaffMovement[]
  coversMade     SubstitutionLog[] @relation("SubstituteStaff")
  coversReceived SubstitutionLog[] @relation("AbsentStaff")
  cpdActivities  CpdActivity[]
  visitorsToSee  Visitor[]      @relation("VisitorSeesStaff")
  homeworkPosted Homework[]
  counselAssigned CounselCase[] @relation("CounselAssigned")
  counselOpened   CounselCase[] @relation("CounselOpened")
  appointmentsToHost Appointment[] @relation("AppointmentSeesStaff")
  appointmentsBooked Appointment[] @relation("AppointmentBookedBy")
}

// ─────────────────────────────────────────────────────────────
// STUDENTS (national registry via nyansapoIndex)
// ─────────────────────────────────────────────────────────────
model Student {
  id                     String                   @id @default(cuid())
  nyansapoIndex          String                   @unique // NY-YYYY-NNNNNN national student index
  firstName              String
  lastName               String
  otherNames             String?
  gender                 String // M | F
  dateOfBirth            DateTime?
  photoSeed              String?
  guardianName           String
  guardianPhone          String
  guardianAltPhone       String?
  guardianEmail          String?
  guardianOccupation     String?
  guardianAddress        String?
  relationship           String                   @default("Parent")
  hometown               String?
  previousSchool         String?
  // father / mother detail (iEduPro student_add_new parity)
  fatherName             String?
  fatherPhone            String?
  fatherOccupation       String?
  motherName             String?
  motherPhone            String?
  motherOccupation       String?
  // medical & background (iEduPro parity)
  nationality            String?
  religion               String?
  bloodGroup             String? // A+ | A- | B+ | B- | AB+ | AB- | O+ | O-
  allergies              String?
  medicalConditions      String?
  emergencyContact       String?
  photoUrl               String? // portrait data-URL (resized client-side at intake)
  dietNote               String? // special-diet flag (iEduPro student_on_special_diet): allergies, vegetarian, religious observance…
  syncClientId           String?                  @unique // offline-queue clientId that created this row — makes /api/sync re-flush idempotent
  status                 String                   @default("ACTIVE") // ACTIVE | TRACKED (not currently enrolled)
  createdAt              DateTime                 @default(now())
  enrollments            Enrollment[]
  invoices               Invoice[]
  marks                  Mark[]
  attendanceRecords      AttendanceRecord[]
  flags                  StudentFlag[]
  reportCards            ReportCard[]
  termResults            TermResult[]
  transfers              TransferRecord[]
  recordRequests         RecordRequest[]
  inquiries              AdmissionInquiry[]
  riskScores             RiskScore[]
  serviceEnrollments     DailyServiceEnrollment[]
  wallet                 StudentWallet?
  walletTxns             WalletTxn[]
  serviceBalances        ServiceBalance[]
  dailyCharges           DailyCharge[]
  dailyMealExceptions    DailyMealException[]
  transportAssignments   TransportAssignment[]
  smsMessages            SmsMessage[]
  discountApplications   DiscountApplication[]
  libraryLoans           LibraryLoan[]
  bookRequests           BookRequest[]
  portfolioEntries       PortfolioEntry[]
  dailyFeeAudits         DailyFeeAudit[]
  issuedDocuments        IssuedDocument[]
  bedAssigned            Bed?                     @relation("BedOccupant")
  housePrefectOf         BoardingHouse[]          @relation("HousePrefect")
  dormPrefectOf          Dormitory[]              @relation("DormitoryPrefect")
  onlineExamAttempts     OnlineExamAttempt[]
  stockIssues            StockMovement[]
  posPayments            Payment[]
  paymentRequests        PaymentRequest[]
  credits                StudentCredit[]
  crecheRatings          CrecheRating[]
  disciplineCases        DisciplineCase[]
  beneficiaries          Beneficiary[]
  healthVisits           HealthVisit[]
  healthScreeningRecords HealthScreeningRecord[]
  clubMemberships        ClubMembership[]
  waecCandidacies        WaecCandidacy[]
  homeworkSubmissions    HomeworkSubmission[]
  counselCases           CounselCase[]
}

model Enrollment {
  id               String    @id @default(cuid())
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id])
  classroomId      String
  classroom        Classroom @relation(fields: [classroomId], references: [id])
  sectionId        String? // optional stream within the class (Section model)
  section          Section?  @relation(fields: [sectionId], references: [id])
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id])
  rollNo           Int?
  admissionDate    DateTime
  exitDate         DateTime?
  status           String    @default("ACTIVE") // ACTIVE | WITHDRAWN | TRANSFERRED | GRADUATED | EXPELLED
  exitReason       String?
  // promotion trail (iEduPro student_promotion parity): the class the learner
  // was moved up from, and when — the placement row itself is reassigned
  promotedFromName String?
  promotedAt       DateTime?
  // boarding (iEduPro enroll.residence_type): DAY | BOARDING
  residenceType    String    @default("DAY")
}

// Weekly class routine (timetable). Day 1 = Monday … 5 = Friday (0/6 weekend).
model TimetableSlot {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  subjectId   String?
  subject     Subject?  @relation(fields: [subjectId], references: [id])
  staffId     String?
  staff       Staff?    @relation(fields: [staffId], references: [id])
  subjectName String // free-text fallback when subject not in catalog
  dayOfWeek   Int // 1–5 (Mon–Fri); 0 Sunday, 6 Saturday
  startMinute Int // minutes from midnight, e.g. 480 = 08:00
  endMinute   Int
  notes       String?
  createdAt   DateTime  @default(now())
  substitutions SubstitutionLog[]

  @@index([schoolId, classroomId, dayOfWeek, startMinute])
}

// ─────────────────────────────────────────────────────────────
// FEES, INVOICES, PAYMENTS
// ─────────────────────────────────────────────────────────────
model FeeStructure {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  termId      String
  term        Term      @relation(fields: [termId], references: [id])
  items       FeeItem[]
  totalCents  Int       @default(0)
}

model FeeItem {
  id             String       @id @default(cuid())
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  name           String
  amountCents    Int
  isOptional     Boolean      @default(false)
}

/**
 * ── BILL ITEM CATALOG (CI3 bill_item — student_payment.php “Add Billing
 * Item” tab): the school-wide reusable fee catalog that feeds the mass
 * invoice wizard. Applicability: specificClassIds > classCategory > ALL. ──
 */
model BillItem {
  id               String   @id @default(cuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id])
  title            String
  category         String   @default("General") // Tuition | Exams | Books | ICT | Meals | Transport | Other…
  classCategory    String   @default("ALL") // ALL | CRECHE | NURSERY | KG | PRIMARY | JHS | SENIOR
  specificClassIds Json? // string[] of classroom ids — overrides classCategory
  amountCents      Int
  description      String?
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([schoolId, title])
  @@index([schoolId])
}

model Invoice {
  id             String           @id @default(cuid())
  invoiceNo      String           @unique
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id])
  termId         String
  term           Term             @relation(fields: [termId], references: [id])
  classroomName  String?
  items          InvoiceItem[]
  totalCents     Int              @default(0)
  discountCents  Int              @default(0)
  discountReason String?
  paidCents      Int              @default(0)
  status         String           @default("UNPAID") // PAID | PARTIAL | UNPAID | OVERDUE | WRITTEN_OFF
  dueDate        DateTime?
  paymentPlan    String           @default("FULL") // FULL | INSTALLMENTS
  writtenOff     Boolean          @default(false)
  writeOffNote   String? // audit: who wrote off, original amount, reason
  createdAt      DateTime         @default(now())
  payments       Payment[]
  momoRequests   PaymentRequest[]
  paymentPlans   PaymentPlan[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  name        String
  amountCents Int
}

model Payment {
  id             String          @id @default(cuid())
  receiptNo      String          @unique
  invoiceId      String?
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id])
  studentId      String?
  student        Student?        @relation(fields: [studentId], references: [id])
  category       String          @default("INVOICE") // INVOICE | DAILY
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id])
  amountCents    Int
  method         String // CASH | MOMO_MTN | MOMO_TELECEL | MOMO_AT | BANK | CHEQUE | CARD
  paymentType    String          @default("PAYMENT") // PAYMENT | REFUND | CREDIT
  reference      String?
  bankName       String?
  chequeNo       String?
  receivedByName String?
  paidAt         DateTime
  recordedAt     DateTime        @default(now())
  offlineQueued  Boolean         @default(false)
  syncedAt       DateTime?
  syncClientId   String?         @unique // offline-queue clientId that minted this receipt — DB-level re-flush idempotency (a retry storm can never double-charge)
  voided         Boolean         @default(false)
  splitJson      Json? // SPLIT collections — [{method, amountCents, reference}] summing to amountCents
  dailyCharges   DailyCharge[]
  appliedRequest PaymentRequest? @relation("HubtelAppliedPayment")
}

// ─────────────────────────────────────────────────────────────
// MOMO / ONLINE PAYMENT REQUESTS (Hubtel)
// A request the school raises for a parent to pay by mobile money —
// either a USSD push ("momo prompt") to the guardian's phone or a hosted
// checkout link. Completion arrives via the Hubtel webhook (or an on-demand
// status check) and is applied to the right ledger: invoice, daily items,
// per-item balance or wallet.
// ─────────────────────────────────────────────────────────────
model PaymentRequest {
  id               String         @id @default(cuid())
  schoolId         String
  school           School         @relation(fields: [schoolId], references: [id])
  studentId        String?
  student          Student?       @relation(fields: [studentId], references: [id])
  purpose          String // INVOICE | DAILY_ITEMS | ITEM_BALANCE | WALLET
  invoiceId        String? // INVOICE — the termly fee invoice being settled
  invoice          Invoice?       @relation(fields: [invoiceId], references: [id])
  items            Json? // DAILY_ITEMS / ITEM_BALANCE — [{serviceId, amountCents}]
  walletKind       String? // WALLET — PREPAID | TRANSPORT | ITEM (with items[0])
  amountCents      Int
  method           String // MOMO_PROMPT | PAYMENT_LINK
  channel          String? // mtn-gh | vodafone-gh | tigo-gh (prompt)
  payerName        String
  payerMsisdn      String
  status           String         @default("PENDING") // PENDING | COMPLETED | FAILED | CANCELLED
  provider         String         @default("HUBTEL") // HUBTEL | SIMULATED
  clientReference  String         @unique
  providerTxnId    String?
  checkoutToken    String?
  checkoutUrl      String?
  appliedPaymentId String?        @unique
  appliedPayment   Payment?       @relation("HubtelAppliedPayment", fields: [appliedPaymentId], references: [id])
  appliedNote      String? // human-readable allocation breakdown
  failureReason    String?
  lastCheckedAt    DateTime?
  completedAt      DateTime?
  createdByName    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  events           PaymentEvent[]
}

model PaymentEvent {
  id        String         @id @default(cuid())
  requestId String
  request   PaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind      String // INITIATED | CALLBACK | STATUS_CHECK | COMPLETED | FAILED | CANCELLED | LINK_SHARED | ERROR
  payload   Json?
  note      String?
  createdAt DateTime       @default(now())
}

// ─────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────
model AttendanceSession {
  id          String             @id @default(cuid())
  classroomId String
  classroom   Classroom          @relation(fields: [classroomId], references: [id])
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id])
  termId      String
  term        Term               @relation(fields: [termId], references: [id])
  date        DateTime
  takenByName String?
  syncClientId String?          @unique // offline-queue clientId that minted this session — durable re-flush idempotency
  records     AttendanceRecord[]
}

model AttendanceRecord {
  id            String            @id @default(cuid())
  sessionId     String
  session       AttendanceSession @relation(fields: [sessionId], references: [id])
  studentId     String
  student       Student           @relation(fields: [studentId], references: [id])
  status        String            @default("PRESENT") // PRESENT | ABSENT | LATE | SICK | SICK_HOME | SICK_CLINIC | BUSY | EXCUSED
  excusedReason String? // why the learner is excused (required when EXCUSED - iEduPro parity)
  markedOffline Boolean           @default(false)
}

// ─────────────────────────────────────────────────────────────
// GRADEBOOK & REPORT CARDS
// ─────────────────────────────────────────────────────────────
model Assessment {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  termId      String
  term        Term      @relation(fields: [termId], references: [id])
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  title       String
  type        String // EXERCISE | HOMEWORK | PROJECT | QUIZ | GROUP_WORK | MID_TERM | END_OF_TERM
  maxScore    Int       @default(100)
  date        DateTime
  marks       Mark[]
}

model Mark {
  id             String     @id @default(cuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id])
  studentId      String
  student        Student    @relation(fields: [studentId], references: [id])
  score          Float?
  enteredOffline Boolean    @default(false)
}

// ─────────────────────────────────────────────────────────────
// TERM RESULTS & REPORT CARDS (wave 20 — Ghana BECE style)
// TermResult is the normalized, per student+term+subject ledger:
// class assessment (≤30) + end-of-term exam (≤70) = total (≤100),
// graded on the WAEC BECE band (A1..F9) and competition-ranked
// within the class. ReportCard is the compiled per-student sheet
// (best-6 aggregate, class position, attendance, remarks).
// ─────────────────────────────────────────────────────────────
model TermResult {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  termId      String
  term        Term      @relation(fields: [termId], references: [id])
  classroomId String // class the learner sat in when compiled (snapshot)
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  classScore  Float? // class assessment out of 30
  examScore   Float? // end-of-term exam out of 70
  total       Float? // weightedTotal = class + exam, out of 100
  grade       String? // WAEC BECE band: A1..F9 (value 1..9)
  position    Int? // subject rank within the class (competition ranking — ties share)
  remarks     String?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([studentId, termId, subjectId])
  @@index([termId, classroomId])
  @@index([schoolId])
}

model ReportCard {
  id            String             @id @default(cuid())
  studentId     String
  student       Student            @relation(fields: [studentId], references: [id])
  termId        String
  term          Term               @relation(fields: [termId], references: [id])
  classroomName String
  results       ReportCardResult[]
  totalScore    Float?
  average       Float?
  classPosition Int?
  classSize     Int?
  conduct       String? // A | B | C
  interest      String?
  attendance    String? // "Present 38 of 42 days"
  teacherRemark String?
  headRemark    String?
  aiGenerated   Boolean            @default(false)
  promotion     String? // PROMOTED | PROBATION | REPEAT
  published     Boolean            @default(false)
  publishedAt   DateTime?
  createdAt     DateTime           @default(now())
  // wave 20 — BECE-style compilation
  aggregate     Float? // best-6 BECE aggregate (lower is better; 6 = all A1)
  attendancePct Float? // days attended / days taken, for the term
  promoted      Boolean? // promoted to the next class (avg ≥ 40)
  // wave 35 — legacy marksheet aggregation parity (student_marksheet.php / conducts_update)
  conductIds   Json? // up to 15 ConductItem ids (legacy aggregation.c1..c15)
  interestId    String? // single ConductItem id (kind INTEREST)
  daysOpened    Int? // marksheet attendance line — school days this term
  daysPresent   Int? // marksheet attendance line — days the learner attended
  // wave 47 — student_marksheet_2 style-2 entry parity (conducts_update_2):
  attitude      String? // free-text attitude line (legacy placeholder DEPENDABLE)
  remarkSource  String? // TEMPLATE | CUSTOM — provenance of teacherRemark
  headSource    String? // TEMPLATE | CUSTOM — provenance of headRemark

  @@unique([studentId, termId])
}

model ReportCardResult {
  id           String     @id @default(cuid())
  reportCardId String
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id])
  subjectName  String
  subjectCode  String? // WAEC BECE subject code (101 Mathematics, 102 English…)
  isCore       Boolean    @default(false) // core subjects drive the BECE aggregate
  classScore   Float?
  examScore    Float?
  total        Float?
  grade        String?
  remark       String?
  position     Int? // position in subject for the class (1st, 2nd…)
}

// ─────────────────────────────────────────────────────────────
// RESULTS GOVERNANCE (CI3 Academic_control parity): head-teacher
// control over each class's results — submit → approve → lock,
// with an append-only audit trail. Marks entry is blocked once a
// class leaves DRAFT; unlocking returns it to DRAFT.
// ─────────────────────────────────────────────────────────────
model ResultApproval {
  id          String                @id @default(cuid())
  schoolId    String
  school      School                @relation(fields: [schoolId], references: [id])
  classroomId String
  classroom   Classroom             @relation(fields: [classroomId], references: [id])
  termId      String
  term        Term                  @relation(fields: [termId], references: [id])
  status      String                @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | LOCKED
  submittedBy String?
  submittedAt DateTime?
  approvedBy  String?
  approvedAt  DateTime?
  lockedBy    String?
  lockedAt    DateTime?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  audits      ResultApprovalAudit[]

  @@unique([classroomId, termId])
}

model ResultApprovalAudit {
  id             String         @id @default(cuid())
  approvalId     String
  approval       ResultApproval @relation(fields: [approvalId], references: [id])
  action         String // SUBMIT | APPROVE | LOCK | UNLOCK
  previousStatus String
  newStatus      String
  performedBy    String
  reason         String?
  createdAt      DateTime       @default(now())
}

// Report card remarks library — iedupro parity
model RemarkTemplate {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  category   String // TEACHER_POSITIVE | TEACHER_NEUTRAL | TEACHER_NEGATIVE | HEAD_RANGE
  minPercent Int? // HEAD_RANGE: band floor
  maxPercent Int? // HEAD_RANGE: band ceiling
  text       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// Conduct traits & interests printed on report sheets — iedupro parity
model ConductItem {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])
  name      String
  kind      String // CONDUCT | INTEREST
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

// ─────────────────────────────────────────────────────────────
// CROSS-SCHOOL: FLAGS, TRANSFERS, RECORD REQUESTS, ADMISSIONS
// ─────────────────────────────────────────────────────────────
model StudentFlag {
  id              String             @id @default(cuid())
  studentId       String
  student         Student            @relation(fields: [studentId], references: [id])
  schoolId        String
  school          School             @relation("FlagsRaised", fields: [schoolId], references: [id])
  raisedByName    String
  type            String // FEE_ARREARS | WITHDREW_OWING | DISCIPLINE_SUSPENSION | DISCIPLINE_EXPULSION | EXAM_MALPRACTICE | PROPERTY_UNRETURNED
  severity        String // LOW | MEDIUM | HIGH | CRITICAL
  status          String             @default("ACTIVE") // ACTIVE | RESOLVED | CONTESTED | WITHDRAWN
  amountOwedCents Int?
  description     String
  raisedAt        DateTime           @default(now())
  resolvedAt      DateTime?
  resolutionNote  String?
  resolvedByName  String?
  verifications   FlagVerification[]
}

// ─────────────────────────────────────────────────────────────
// DISCIPLINE & CONDUCT (wave 25 — iEduPro discipline parity):
// the day-to-day conduct register. INCIDENT rows are offences with a
// severity ladder and an OPEN → RESOLVED / ESCALATED workflow;
// COMMENDATION rows are positive records (academic excellence, service,
// good deeds) that feed the commendations wall. Guardians can be SMS-notified
// per case (parentNotifiedAt stamp, message logged in SmsMessage with
// category DISCIPLINE). Major escalations may also raise a StudentFlag —
// that stays a manual head-teacher decision, never automatic.
// ─────────────────────────────────────────────────────────────
model DisciplineCase {
  id               String    @id @default(cuid())
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id])
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id])
  kind             String // INCIDENT | COMMENDATION
  date             DateTime  @default(now())
  category         String // e.g. Late coming, Truancy, Academic excellence
  severity         String? // MINOR | MODERATE | MAJOR (incidents only)
  description      String
  actionTaken      String? // Verbal warning, Parent called, Suspension…
  status           String    @default("OPEN") // OPEN | RESOLVED | ESCALATED
  resolutionNote   String?
  resolvedAt       DateTime?
  recordedByName   String?
  resolvedByName   String?
  parentNotifiedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([schoolId, kind, date])
  @@index([schoolId, status])
  @@index([studentId, date])
}

// HEALTH & WELLNESS CLINIC (wave 26 — sick-bay register & SHEP screenings):
// the infirmary ledger every Ghanaian school nurse keeps — clinic visits with
// vitals, treatment and disposition (returned to class / sent home / referred
// / follow-up), plus whole-school screening events (height, weight, BMI,
// vision, hearing) with per-learner records.

model HealthVisit {
  id               String    @id @default(cuid())
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id])
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id])
  date             DateTime  @default(now())
  category         String // e.g. Fever / malaria suspicion, Headache, Injury
  severity         String    @default("MINOR") // MINOR | MODERATE | MAJOR
  complaint        String
  temperature      Float? // °C at triage
  treatment        String? // what was done at the sick bay
  medication       String? // e.g. Paracetamol 500mg × 1
  disposition      String    @default("RETURNED_CLASS") // RETURNED_CLASS | SENT_HOME | REFERRED | FOLLOWUP
  status           String    @default("OPEN") // OPEN (follow-up pending) | CLOSED
  outcomeNote      String?
  closedAt         DateTime?
  recordedByName   String?
  closedByName     String?
  parentNotifiedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([schoolId, date])
  @@index([schoolId, status])
  @@index([studentId, date])
}

model HealthScreening {
  id            String                  @id @default(cuid())
  schoolId      String
  school        School                  @relation(fields: [schoolId], references: [id])
  title         String // e.g. "Term 1 Health Screening"
  screenDate    DateTime
  status        String                  @default("OPEN") // OPEN (recording) | COMPLETED
  notes         String?
  createdByName String?
  createdAt     DateTime                @default(now())
  records       HealthScreeningRecord[]

  @@index([schoolId, screenDate])
}

model HealthScreeningRecord {
  id             String          @id @default(cuid())
  screeningId    String
  screening      HealthScreening @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student         @relation(fields: [studentId], references: [id])
  heightCm       Float?
  weightKg       Float?
  bmi            Float? // computed on save from height/weight
  vision         String? // PASS | REFER | free note
  hearing        String? // PASS | REFER | free note
  finding        String? // overall finding / observation
  referred       Boolean         @default(false)
  note           String?
  recordedByName String?
  createdAt      DateTime        @default(now())

  @@unique([screeningId, studentId])
  @@index([studentId])
}

// CLUBS & SOCIETIES (wave 27 — the co-curricular register):
// the club ledger — club register with patron & meeting venue, membership
// rosters with executive offices (President / Vice / Secretary / Treasurer /
// Organiser — one holder per office), the meeting register with attendance
// (present / absent / excused), inter-schools & competition events with
// outcomes and placements, learner co-curricular profiles, analytics and
// guardian meeting notices through the SMS centre.

model Club {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  name          String
  category      String    @default("GENERAL") // ACADEMIC | SERVICE | FAITH | CULTURAL | SPORTS | GENERAL
  description   String?
  patronName    String?
  meetingDay    String? // e.g. Wednesday
  venue         String?
  status        String    @default("ACTIVE") // ACTIVE | DORMANT | ARCHIVED
  foundedOn     DateTime?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships ClubMembership[]
  meetings    ClubMeeting[]
  events      ClubEvent[]

  @@unique([schoolId, name])
  @@index([schoolId, status])
}

model ClubMembership {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  clubId        String
  club          Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  office        String? // PRESIDENT | VICE_PRESIDENT | SECRETARY | TREASURER | ORGANISER
  joinedOn      DateTime  @default(now())
  status        String    @default("ACTIVE") // ACTIVE | LEFT
  leftOn        DateTime?
  leftReason    String?
  createdByName String?

  attendance ClubAttendance[]

  @@unique([clubId, studentId])
  @@index([schoolId, status])
  @@index([studentId])
}

model ClubMeeting {
  id                  String    @id @default(cuid())
  schoolId            String
  school              School    @relation(fields: [schoolId], references: [id])
  clubId              String
  club                Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  date                DateTime
  topic               String?
  minutes             String?
  takenByName         String?
  guardiansNotifiedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  attendance ClubAttendance[]

  @@index([schoolId, date])
  @@index([clubId, date])
}

model ClubAttendance {
  id           String         @id @default(cuid())
  meetingId    String
  meeting      ClubMeeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  membershipId String
  membership   ClubMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  status       String         @default("ABSENT") // PRESENT | ABSENT | EXCUSED
  note         String?

  @@unique([meetingId, membershipId])
}

model ClubEvent {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  clubId         String?
  club           Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title          String
  date           DateTime
  level          String   @default("SCHOOL") // SCHOOL | ZONAL | DISTRICT | REGIONAL | NATIONAL
  outcome        String   @default("UPCOMING") // UPCOMING | COMPLETED
  placement      String? // e.g. 1st / Runner-up / 3rd
  participants   String? // learners who represented the school
  note           String?
  recordedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([schoolId, date])
}

model FlagVerification {
  id           String      @id @default(cuid())
  flagId       String
  flag         StudentFlag @relation(fields: [flagId], references: [id])
  officerName  String
  officerTitle String
  action       String // CONFIRMED | EVIDENCE_REQUESTED | DISMISSED
  note         String?
  verifiedAt   DateTime    @default(now())
}

model TransferRecord {
  id                String   @id @default(cuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  fromSchoolId      String
  fromSchool        School   @relation("TransfersFrom", fields: [fromSchoolId], references: [id])
  toSchoolId        String
  toSchool          School   @relation("TransfersTo", fields: [toSchoolId], references: [id])
  date              DateTime
  reason            String?
  outstandingCents  Int      @default(0)
  documentsReleased Boolean  @default(false)
  initiatedBy       String   @default("PARENT") // PARENT | SCHOOL
  status            String   @default("COMPLETED") // COMPLETED | PENDING_RELEASE | DECLINED
  notes             String?
}

model RecordRequest {
  id                 String           @id @default(cuid())
  studentId          String
  student            Student          @relation(fields: [studentId], references: [id])
  requestingSchoolId String
  requestingSchool   School           @relation("RequestsFrom", fields: [requestingSchoolId], references: [id])
  targetSchoolId     String
  targetSchool       School           @relation("RequestsTo", fields: [targetSchoolId], references: [id])
  requestedByName    String
  requestedAt        DateTime         @default(now())
  purpose            String           @default("ADMISSION") // ADMISSION | TRANSFER | VERIFICATION
  status             String           @default("PENDING") // PENDING | APPROVED | DECLINED | FULFILLED
  respondedAt        DateTime?
  respondedByName    String?
  notes              String?
  messages           RequestMessage[]
}

model RequestMessage {
  id          String        @id @default(cuid())
  requestId   String
  request     RecordRequest @relation(fields: [requestId], references: [id])
  senderName  String
  senderTitle String
  body        String
  sentAt      DateTime      @default(now())
}

model AdmissionInquiry {
  id                String    @id @default(cuid())
  schoolId          String
  school            School    @relation(fields: [schoolId], references: [id])
  studentName       String
  dateOfBirth       DateTime?
  gender            String?
  guardianName      String
  guardianPhone     String
  guardianEmail     String?
  classAppliedFor   String
  matchedStudentId  String?
  matchedStudent    Student?  @relation(fields: [matchedStudentId], references: [id])
  registryCheckedAt DateTime?
  registrySummary   String? // JSON snapshot
  status            String    @default("NEW") // NEW | MATCHED | FLAGGED | CLEARED | ENROLLED | DECLINED
  handledByName     String?
  notes             String?
  createdAt         DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// AI, RISK, ANNOUNCEMENTS
// ─────────────────────────────────────────────────────────────
model RiskScore {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  termId         String?
  score          Int // 0-100
  level          String // LOW | MODERATE | HIGH | CRITICAL
  factorsJson    String // JSON
  recommendation String?
  computedAt     DateTime @default(now())
}

model Announcement {
  id                String           @id @default(cuid())
  schoolId          String?
  school            School?          @relation(fields: [schoolId], references: [id])
  associationNodeId String?
  associationNode   AssociationNode? @relation(fields: [associationNodeId], references: [id])
  title             String
  body              String
  audience          String           @default("SCHOOLS") // SCHOOLS | PARENTS | ZONAL | DISTRICT | REGIONAL | NATIONAL
  category          String           @default("GENERAL") // GENERAL | COMPLIANCE | CALENDAR | URGENT | TRAINING
  priority          String           @default("NORMAL") // NORMAL | HIGH
  postedByName      String
  postedAt          DateTime         @default(now())
}

model AiChatMessage {
  id         String   @id @default(cuid())
  sessionKey String // user-scoped key
  role       String // user | assistant
  content    String
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// ONLINE EXAMS (iEduPro online_exam parity) — MCQ papers published to a
// class, attempted by learners, auto-marked against the answer key
// ─────────────────────────────────────────────────────────────
model OnlineExam {
  id            String               @id @default(cuid())
  schoolId      String
  school        School               @relation(fields: [schoolId], references: [id])
  classroomId   String?
  classroom     Classroom?           @relation(fields: [classroomId], references: [id])
  subjectName   String
  title         String
  description   String?
  durationMins  Int                  @default(30)
  scheduledAt   DateTime?
  status        String               @default("DRAFT") // DRAFT | PUBLISHED | CLOSED
  createdByName String?
  createdAt     DateTime             @default(now())
  questions     OnlineExamQuestion[]
  attempts      OnlineExamAttempt[]
}

model OnlineExamQuestion {
  id            String     @id @default(cuid())
  examId        String
  exam          OnlineExam @relation(fields: [examId], references: [id])
  prompt        String
  type          String     @default("MCQ") // MCQ | TRUE_FALSE | FILL_BLANKS (CI3 multiple_choice | true_false | fill_in_the_blanks)
  optionA       String? // MCQ only
  optionB       String? // MCQ only
  optionC       String? // MCQ only
  optionD       String? // MCQ only
  correctOption String // MCQ: A | B | C | D · TRUE_FALSE: TRUE | FALSE · FILL_BLANKS: unused
  blankAnswers  String? // FILL_BLANKS only — JSON array of accepted words (lowercase, trimmed)
  marks         Int        @default(1)
  sortOrder     Int        @default(0)
}

model OnlineExamAttempt {
  id          String     @id @default(cuid())
  examId      String
  exam        OnlineExam @relation(fields: [examId], references: [id])
  studentId   String
  student     Student    @relation(fields: [studentId], references: [id])
  schoolId    String
  school      School     @relation(fields: [schoolId], references: [id])
  answers     String // JSON { "0": "A", "1": "C", … } keyed by question sortOrder
  score       Int?
  startedAt   DateTime? // set when the learner opens the paper — live-monitor signal (score null = still in progress)
  submittedAt DateTime   @default(now())

  @@unique([examId, studentId])
}

// ─────────────────────────────────────────────────────────────
// DAILY SERVICES (canteen, water, extra classes) — micro-billing
// ─────────────────────────────────────────────────────────────
model DailyService {
  id             String                   @id @default(cuid())
  schoolId       String
  school         School                   @relation(fields: [schoolId], references: [id])
  name           String // Lunch, Breakfast, Sachet Water, Extra Classes
  category       String // MEAL | DRINK | CLASS | CARE | TRANSPORT | OTHER
  priceCents     Int // standard school-wide rate (one-way fare for TRANSPORT — the per-trip charge)
  chargeMode     String                   @default("DAILY") // DAILY (every school day) | WEEKLY (once a week, first school day)
  weekdays       String                   @default("1,2,3,4,5") // ISO weekdays the service runs (e.g. "3" = Wednesdays only)
  active         Boolean                  @default(true)
  optInDaily     Boolean                  @default(false) // optional-by-default service (e.g. breakfast): charged only when the learner opts in for the day
  enrollments    DailyServiceEnrollment[]
  charges        DailyCharge[]
  classRates     DailyServiceRate[]
  balances       ServiceBalance[]
  mealExceptions DailyMealException[]
}

// ── Per-classroom rate overrides (iedupro daily_fee_rates: rates are set per
//    class-section per fee type). Resolution: student override → class rate →
//    service standard price. ──
model DailyServiceRate {
  id          String       @id @default(cuid())
  serviceId   String
  service     DailyService @relation(fields: [serviceId], references: [id])
  classroomId String
  classroom   Classroom    @relation(fields: [classroomId], references: [id])
  priceCents  Int

  @@unique([serviceId, classroomId])
}

model DailyServiceEnrollment {
  id                 String       @id @default(cuid())
  serviceId          String
  service            DailyService @relation(fields: [serviceId], references: [id])
  studentId          String
  student            Student      @relation(fields: [studentId], references: [id])
  priceCentsOverride Int? // subsidised rate per learner (e.g. needy-family support)
  active             Boolean      @default(true)
  enrolledAt         DateTime     @default(now())

  @@unique([serviceId, studentId])
}

model DailyCharge {
  id          String       @id @default(cuid())
  serviceId   String
  service     DailyService @relation(fields: [serviceId], references: [id])
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id])
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id])
  date        DateTime
  amountCents Int
  status      String       @default("OWED") // OWED | PAID | WAIVED
  usage       String? // transport fare usage: MORNING | AFTERNOON | BOTH | NOT_USING | BOARDED (TRANSPORT-category services only)
  paymentId   String?
  payment     Payment?     @relation(fields: [paymentId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([serviceId, studentId, date]) // not unique: partial payments split a day-charge into PAID + remainder rows
}

// ── Daily meal opt-in / opt-out (dining register parity): a learner skips a
//    default meal (e.g. lunch) on a given day so no charge is generated, or
//    joins an optional service (e.g. breakfast — optInDaily) for a day.
//    Parents request from their portal (PENDING); the school approves.
//    Staff-created exceptions are APPROVED immediately.
model DailyMealException {
  id              String       @id @default(cuid())
  schoolId        String
  school          School       @relation(fields: [schoolId], references: [id])
  studentId       String
  student         Student      @relation(fields: [studentId], references: [id])
  serviceId       String
  service         DailyService @relation(fields: [serviceId], references: [id])
  date            DateTime
  kind            String // OPT_OUT (skip a default service) | OPT_IN (join an optInDaily service)
  status          String       @default("PENDING") // PENDING | APPROVED | DECLINED
  reason          String?
  requestedByName String?
  decidedByName   String?
  decidedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([studentId, serviceId, date, kind])
  @@index([schoolId, date, status])
}

// ── Daily-fee wallets (iedupro parity): prepaid balance for any daily service,
//    transport wallet reserved for bus fare. Arrears are derived from OWED charges.
model StudentWallet {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  studentId      String   @unique
  student        Student  @relation(fields: [studentId], references: [id])
  prepaidCents   Int      @default(0)
  transportCents Int      @default(0)
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([schoolId])
}

model WalletTxn {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  wallet       String // GENERAL | PREPAID | TRANSPORT | ITEM (per-service balance; see serviceId)
  kind         String // TOPUP | PAY | ADJUST
  amountCents  Int // signed: + credit, − debit
  balanceAfter Int
  note         String?
  byName       String?
  serviceId    String? // set when wallet = ITEM — the daily-service item the txn moved
  at           DateTime @default(now())

  @@index([schoolId, studentId])
}

// Per-item prepaid balances (iEduPro daily_fee_wallet parity — each fee item
// carries its own prepaid credit; charges auto-deduct from it, excess payments
// land back on it as advance). The general StudentWallet.prepaidCents remains
// a flexible any-item credit line.
model ServiceBalance {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id])
  studentId    String
  student      Student      @relation(fields: [studentId], references: [id])
  serviceId    String
  service      DailyService @relation(fields: [serviceId], references: [id])
  prepaidCents Int          @default(0)
  updatedAt    DateTime     @default(now()) @updatedAt

  @@unique([studentId, serviceId])
  @@index([schoolId])
}

// ─────────────────────────────────────────────────────────────
// TRANSPORTATION (routes, vehicles, assignments, trips)
// ─────────────────────────────────────────────────────────────
model TransportRoute {
  id               String                @id @default(cuid())
  schoolId         String
  school           School                @relation(fields: [schoolId], references: [id])
  name             String // "Adenta Loop"
  vehicleReg       String // "GR 4521-21"
  vehicleModel     String?
  driverName       String
  driverPhone      String
  driverId         String? // optional link into the DriverRecord registry
  driver           DriverRecord?         @relation(fields: [driverId], references: [id])
  vehicleId        String? // optional link into the Vehicle registry
  vehicle          Vehicle?              @relation(fields: [vehicleId], references: [id])
  capacity         Int                   @default(15)
  farePerTermCents Int
  farePerTripCents Int                   @default(0) // one-way fare (×2 for BOTH directions)
  stops            String // comma-separated stop names
  active           Boolean               @default(true)
  assignments      TransportAssignment[]
  trips            TransportTrip[]
  stopRecords      TransportStop[]
  boardings        TransportBoarding[]
}

// Structured stops with per-stop fare overrides — iedupro parity
model TransportStop {
  id        String         @id @default(cuid())
  routeId   String
  route     TransportRoute @relation(fields: [routeId], references: [id])
  name      String
  fareCents Int? // null = route default fare
  sortOrder Int            @default(0)
}

// Vehicle registry with statutory expiry tracking — iedupro parity
model Vehicle {
  id               String           @id @default(cuid())
  schoolId         String
  school           School           @relation(fields: [schoolId], references: [id])
  regNumber        String           @unique
  model            String?
  capacity         Int              @default(15)
  insuranceExpiry  DateTime?
  roadworthyExpiry DateTime?
  status           String           @default("ACTIVE") // ACTIVE | MAINTENANCE | RETIRED
  notes            String?
  createdAt        DateTime         @default(now())
  routes           TransportRoute[]
}

// Driver registry (staff-linked or standalone) — iedupro parity
model DriverRecord {
  id            String           @id @default(cuid())
  schoolId      String
  school        School           @relation(fields: [schoolId], references: [id])
  name          String
  phone         String?
  licenseNo     String?
  licenseExpiry DateTime?
  staffId       String? // optional link to a Staff record
  status        String           @default("ACTIVE") // ACTIVE | SUSPENDED | RETIRED
  createdAt     DateTime         @default(now())
  routes        TransportRoute[]
}

// Daily boarding records (morning collection) — direction-based fares
model TransportBoarding {
  id             String              @id @default(cuid())
  assignmentId   String
  assignment     TransportAssignment @relation(fields: [assignmentId], references: [id])
  routeId        String
  route          TransportRoute      @relation(fields: [routeId], references: [id])
  date           DateTime
  direction      String              @default("NONE") // IN | OUT | BOTH | NONE
  fareCents      Int                 @default(0) // 1× trip fare (×2 for BOTH)
  paidCents      Int                 @default(0)
  recordedByName String?
  createdAt      DateTime            @default(now())

  @@unique([assignmentId, date])
}

model TransportAssignment {
  id                 String              @id @default(cuid())
  routeId            String
  route              TransportRoute      @relation(fields: [routeId], references: [id])
  studentId          String
  student            Student             @relation(fields: [studentId], references: [id])
  pickupStop         String?
  dropStop           String?
  fareOverrideCents  Int? // per-term override (e.g. half-route rate)
  active             Boolean             @default(true)
  enrolledAt         DateTime            @default(now())
  transportBoardings TransportBoarding[]

  @@unique([routeId, studentId])
}

model TransportTrip {
  id             String         @id @default(cuid())
  routeId        String
  route          TransportRoute @relation(fields: [routeId], references: [id])
  date           DateTime
  morningCount   Int?
  eveningCount   Int?
  notes          String?
  recordedByName String?

  @@unique([routeId, date])
}

// ─────────────────────────────────────────────────────────────
// SMS ALERTS (gateway-agnostic: Arkesel / Termii / simulated)
// ─────────────────────────────────────────────────────────────
model SmsSetting {
  id                   String  @id @default(cuid())
  schoolId             String  @unique
  school               School  @relation(fields: [schoolId], references: [id])
  provider             String  @default("SIMULATED") // SIMULATED | ARKESEL | TERMII
  senderId             String  @default("NYANSAPO")
  credits              Int     @default(500)
  autoFeeReminders     Boolean @default(true)
  autoAbsenceAlerts    Boolean @default(true)
  autoPaymentReceipts  Boolean @default(true)
  autoLessonNoteAlerts Boolean @default(true) // teacher SMS when a GES note is returned / endorsed
  autoVisitorAlerts    Boolean @default(true) // front-desk → staff visitor-arrival alerts (SMS + email + in-app)
  autoApptAlerts       Boolean @default(true) // wave 72 — appointment requests, staff responses & T-2-min reminders
  // ── per-event toggles (iEduPro parity — granular control over each trigger) ──
  evtInvoicePaid       Boolean @default(true) // billed invoice settled in full
  evtDailyFeesPaid     Boolean @default(true) // daily-fee payment made (lunch/bus etc.)
  evtLearnerBilled     Boolean @default(true) // invoice issued to a learner
  evtLearnerPresent    Boolean @default(false) // learner marked present (off by default — volume)
  evtLearnerAbsent     Boolean @default(true) // learner marked absent
  evtResultsPublished  Boolean @default(true) // end-of-term results released
  evtPaymentReceipt    Boolean @default(true) // receipt confirmation for any fee payment
  evtOverpaymentCredit Boolean @default(true) // overpayment banked as prepaid credit
}

model SmsTemplate {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])
  name      String
  category  String // FEES | ATTENDANCE | RESULTS | ANNOUNCEMENT | PAYMENT | TRANSPORT | GENERAL
  body      String // supports {student} {school} {amount} {balance} {class} {date} placeholders
  isDefault Boolean @default(false)
}

// Event-driven SMS automations — iedupro parity
model SmsAutomation {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  name       String
  trigger    String // PAYMENT_RECEIVED | INVOICE_ISSUED | ABSENCE_MARKED | RESULTS_PUBLISHED | BILL_REMINDER
  recipients String    @default("GUARDIANS") // GUARDIANS | TEACHERS | ALL
  body       String // placeholders {student} {amount} {balance} {date} {school} {class}
  offsetDays Int       @default(0) // negative = days after event
  active     Boolean   @default(true)
  lastRunAt  DateTime?
  sentCount  Int       @default(0)
  createdAt  DateTime  @default(now())
}

model SmsMessage {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  studentId      String?
  student        Student? @relation(fields: [studentId], references: [id])
  recipientName  String
  recipientPhone String
  body           String
  category       String
  status         String   @default("SENT") // QUEUED | SENT | DELIVERED | FAILED
  creditsUsed    Int      @default(1)
  sentByName     String?
  sentAt         DateTime @default(now())
  errorReason    String?
  provider       String? // gateway that carried the message (SIMULATED | ARKESEL | TERMII)
  providerRef    String? // gateway message id, for delivery follow-up
}

// ─────────────────────────────────────────────────────────────
// MEDIA ASSETS — blob storage for portraits & branding uploads.
// Binary bytes live here (fetched only via /api/media/[id] with lazy
// loading + immutable caching) instead of bloating Student/SchoolSetting
// rows with base64 data-URLs. Swap to S3 later by changing storeMedia
// + the GET route only.
// ─────────────────────────────────────────────────────────────
model MediaAsset {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  kind        String // PORTRAIT | LOGO | SIGNATURE | SITE (public website asset)
  mimeType    String // image/png | image/jpeg | image/webp
  sizeBytes   Int
  data        Bytes
  // wave 54 — public website: assets shown on /site/{code} are served
  // unauthenticated via /api/media/{id}?t={publicToken}; null stays private
  publicToken String?  @unique
  createdAt   DateTime @default(now())
}

// ── wave 60 — siren custom tones (uploaded songs / sounds) ──
// Schools upload their own audio (school song, anthem, hymn, recorded bell,
// gospel track …) and ring it from the console or hang it on the timetable
// like any built-in synthesised sound. Bytes live in Postgres alongside
// portraits & logos; sounds are referenced as "CUSTOM:<toneId>".
model SirenTone {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  label         String
  mimeType      String // audio/mpeg | audio/wav | audio/ogg | audio/mp4 | audio/webm
  sizeBytes     Int
  durationSec   Int      @default(15) // default ring length when this tone is used
  data          Bytes
  createdByName String
  createdAt     DateTime @default(now())

  @@index([schoolId])
}

// ─────────────────────────────────────────────────────────────
// BACKLOG E — DATABASE BACKUP / RESTORE (CI3 admin/backup parity)
// CI3: dbutil->backup → ./backup/database_backup/db-*.sql with
// create / download / delete / restore actions. Port: pg_dump files
// under db/backups/, tracked here with size + author + note.
// ─────────────────────────────────────────────────────────────
model DbBackup {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  filename      String   @unique // db-YYYY-MM-DD_HH-MM-SS.sql
  sizeBytes     Int      @default(0)
  note          String?
  kind          String   @default("MANUAL") // MANUAL | AUTO
  createdByName String
  createdAt     DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// BACKLOG D — EMAIL CHANNEL (CI3 Invoice_email + Email_model parity)
// SMTP settings per school + an EmailMessage log (SmsMessage pattern).
// ─────────────────────────────────────────────────────────────
model EmailSetting {
  id          String  @id @default(cuid())
  schoolId    String  @unique
  school      School  @relation(fields: [schoolId], references: [id])
  enabled     Boolean @default(false)
  host        String? // smtp.gmail.com | smtp.zoho.com …
  port        Int     @default(587)
  secure      Boolean @default(false) // true = TLS/465
  username    String?
  password    String? // server-side only — never returned to the client
  fromName    String?
  fromAddress String?
}

model EmailMessage {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  toAddress   String
  toName      String?
  subject     String
  body        String // HTML body
  category    String   @default("GENERAL") // INVOICE | ANNOUNCEMENT | GENERAL | TEST
  status      String   @default("SENT") // SENT | FAILED | SIMULATED
  errorReason String?
  sentByName  String?
  studentId   String? // optional learner link (invoice emails)
  sentAt      DateTime @default(now())

  @@index([schoolId, sentAt])
}

// ─────────────────────────────────────────────────────────────
// BACKLOG B — INTERNAL MESSAGING (CI3 message_thread/message parity)
// CI3: threads keyed by sender/reciever login pairs; messages with
// ≤4MB attachments; mark-read; delete thread. Port: User↔User threads
// (either direction reuses the same thread), attachments via MediaAsset.
// ─────────────────────────────────────────────────────────────
model MessageThread {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  subject       String
  senderId      String
  sender        User      @relation("MsgSender", fields: [senderId], references: [id])
  recipientId   String
  recipient     User      @relation("MsgRecipient", fields: [recipientId], references: [id])
  messages      Message[]
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([schoolId, lastMessageAt])
}

model Message {
  id           String        @id @default(cuid())
  threadId     String
  thread       MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId     String
  body         String
  attachmentId String? // MediaAsset id — ≤4MB (CI3 parity)
  readAt       DateTime?
  createdAt    DateTime      @default(now())

  @@index([threadId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// BACKLOG A — DOUBLE-ENTRY ACCOUNTS (CI3 Accounts_model parity)
// Chart of accounts → journal entries (DRAFT→POSTED→VOIDED, Σdebit=Σcredit)
// → bank accounts + txns → reconciliation workspace (CI3 Bank_reconciliation).
// ─────────────────────────────────────────────────────────────
model ChartAccount {
  id           String             @id @default(cuid())
  schoolId     String
  school       School             @relation(fields: [schoolId], references: [id])
  code         String // "1000"
  name         String // "Cash in Hand"
  type         String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  parentId     String?
  parent       ChartAccount?      @relation("AccTree", fields: [parentId], references: [id])
  children     ChartAccount[]     @relation("AccTree")
  isBank       Boolean            @default(false) // appears in Bank accounts pickers
  isActive     Boolean            @default(true)
  lines        JournalEntryLine[]
  bankAccounts BankAccount[]
  budgetLines  BudgetLine[]

  @@unique([schoolId, code])
}

model JournalEntry {
  id            String             @id @default(cuid())
  schoolId      String
  school        School             @relation(fields: [schoolId], references: [id])
  entryNumber   String             @unique // JE-2026-0001 (sync-safe)
  entryDate     DateTime
  description   String
  reference     String? // receipt / PO / payslip reference
  status        String             @default("DRAFT") // DRAFT | POSTED | VOIDED
  createdByName String
  postedAt      DateTime?
  postedByName  String?
  lines         JournalEntryLine[]
  createdAt     DateTime           @default(now())

  @@index([schoolId, entryDate])
}

model JournalEntryLine {
  id          String       @id @default(cuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     ChartAccount @relation(fields: [accountId], references: [id])
  debitCents  Int          @default(0)
  creditCents Int          @default(0)
  memo        String?
}

model BankAccount {
  id                  String           @id @default(cuid())
  schoolId            String
  school              School           @relation(fields: [schoolId], references: [id])
  name                String // "Main MTN MoMo Wallet"
  bankName            String?
  accountNumber       String? // masked on display
  chartAccountId      String? // linked ledger account (bank txns adjust it)
  chartAccount        ChartAccount?    @relation(fields: [chartAccountId], references: [id])
  openingBalanceCents Int              @default(0)
  isActive            Boolean          @default(true)
  txns                BankTxn[]
  reconciliations     Reconciliation[]
  createdAt           DateTime         @default(now())
}

model BankTxn {
  id            String               @id @default(cuid())
  schoolId      String
  school        School               @relation(fields: [schoolId], references: [id])
  bankAccountId String
  bankAccount   BankAccount          @relation(fields: [bankAccountId], references: [id])
  date          DateTime
  direction     String // DEPOSIT (money in) | WITHDRAWAL (money out)
  amountCents   Int
  reference     String?
  description   String
  source        String               @default("MANUAL") // MANUAL | PAYMENT | EXPENSE | FEES
  reconciledAt  DateTime? // stamped when a reconciliation completes
  reconItems    ReconciliationItem[]
  createdAt     DateTime             @default(now())

  @@index([bankAccountId, date])
}

model Reconciliation {
  id                String               @id @default(cuid())
  schoolId          String
  school            School               @relation(fields: [schoolId], references: [id])
  bankAccountId     String
  bankAccount       BankAccount          @relation(fields: [bankAccountId], references: [id])
  statementDate     DateTime
  statementEndCents Int // closing balance per the bank statement
  status            String               @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  createdByName     String
  completedAt       DateTime?
  items             ReconciliationItem[]
  createdAt         DateTime             @default(now())
}

model ReconciliationItem {
  id               String         @id @default(cuid())
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  bankTxnId        String? // matched system txn — null = statement-only line
  bankTxn          BankTxn?       @relation(fields: [bankTxnId], references: [id])
  date             DateTime
  description      String
  amountCents      Int // signed: + deposit, − withdrawal (statement view)
  matched          Boolean        @default(false)
}

// ─────────────────────────────────────────────────────────────
// PAYROLL (Ghana: SSNIT Tier 1/2 + PAYE progressive tax)
// ─────────────────────────────────────────────────────────────
model PayrollRun {
  id                      String    @id @default(cuid())
  schoolId                String
  school                  School    @relation(fields: [schoolId], references: [id])
  period                  String // "2026-10"
  status                  String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | PAID
  payslips                Payslip[]
  totalGrossCents         Int       @default(0)
  totalDeductionsCents    Int       @default(0)
  totalNetCents           Int       @default(0)
  totalEmployerSsnitCents Int       @default(0)
  approvedByName          String?
  paidAt                  DateTime?
  createdAt               DateTime  @default(now())

  @@unique([schoolId, period])
}

model Payslip {
  id                   String     @id @default(cuid())
  payrollRunId         String
  payrollRun           PayrollRun @relation(fields: [payrollRunId], references: [id])
  staffId              String
  staff                Staff      @relation(fields: [staffId], references: [id])
  baseSalaryCents      Int
  allowancesJson       String     @default("[]") // [{name, amountCents}]
  grossCents           Int
  ssnitEmployeeCents   Int // 5% Tier 1
  ssnitEmployerCents   Int // 13% Tier 1 + 5% Tier 2
  payeCents            Int
  otherDeductionsJson  String     @default("[]") // [{name, amountCents}]
  totalDeductionsCents Int
  netCents             Int
  status               String     @default("PENDING") // PENDING | PAID
  reference            String? // payslip reference no e.g. PS-2026/10/0142
  workingDays          Int? // attendance proration
  daysPresent          Int?
  paidAt               DateTime?

  @@unique([payrollRunId, staffId])
}

// Tier-2 pension providers (occupational pension trusts) — iedupro parity
model PensionProvider {
  id           String  @id @default(cuid())
  schoolId     String
  school       School  @relation(fields: [schoolId], references: [id])
  name         String
  code         String  @unique
  contactPhone String?
  active       Boolean @default(true)
}

// ─────────────────────────────────────────────────────────────
// INVENTORY (books, uniforms, stationery, food supplies)
// ─────────────────────────────────────────────────────────────
model InventoryItem {
  id             String          @id @default(cuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id])
  name           String
  sku            String?
  category       String // BOOKS | UNIFORMS | STATIONERY | FOOD | CLEANING | FUEL | OTHER
  unit           String          @default("pcs")
  unitCostCents  Int             @default(0)
  sellPriceCents Int? // null = internal use only
  stockQty       Int             @default(0)
  reorderLevel   Int             @default(10)
  location       String?
  movements      StockMovement[]
}

model StockMovement {
  id               String        @id @default(cuid())
  itemId           String
  item             InventoryItem @relation(fields: [itemId], references: [id])
  schoolId         String
  school           School        @relation(fields: [schoolId], references: [id])
  type             String // PURCHASE | ISSUE | RETURN | ADJUST
  qty              Int // signed: + in, - out
  unitCostCents    Int?
  partyType        String? // SUPPLIER | STUDENT | STAFF | CLASS | SALE
  partyName        String?
  studentId        String?
  student          Student?      @relation(fields: [studentId], references: [id])
  chargedToInvoice Boolean       @default(false)
  note             String?
  saleNo           String? // groups the lines of one counter sale (POS)
  amountCents      Int? // line total for counter sales (qty × sell price)
  createdAt        DateTime      @default(now())
}

model Supplier {
  id             String          @id @default(cuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id])
  name           String
  phone          String?
  email          String?
  itemsSupplied  String?
  notes          String?
  purchaseOrders PurchaseOrder[]
}

// ─────────────────────────────────────────────────────────────
// DISCOUNTS (scholarships, siblings, needy support — invoice & daily)
// ─────────────────────────────────────────────────────────────
model Discount {
  id           String                @id @default(cuid())
  schoolId     String
  school       School                @relation(fields: [schoolId], references: [id])
  name         String // "Sibling Discount 10%"
  type         String // PERCENT | FIXED
  value        Int // percent (0-100) or pesewas
  scope        String                @default("INVOICE") // INVOICE | DAILY_SERVICE
  autoApply    Boolean               @default(false) // applied automatically at invoice generation
  active       Boolean               @default(true)
  notes        String?
  createdAt    DateTime              @default(now())
  applications DiscountApplication[]
}

// Discount profiles: named rule-sets assigned to classes / fee items — iedupro parity.
// For DAILY_SERVICE profiles `serviceIds` scopes the subsidy: "*" = every daily
// service, or a comma-separated list of DailyService ids — e.g. lunch-only
// (part or full), extra-classes-only, or "lunch + breakfast".
model DiscountProfile {
  id           String                @id @default(cuid())
  schoolId     String
  school       School                @relation(fields: [schoolId], references: [id])
  name         String
  category     String                @default("INVOICE") // INVOICE | DAILY_SERVICE
  method       String                @default("PERCENT") // PERCENT | FIXED
  value        Int // percent or pesewas
  feeItemName  String                @default("*") // "*" = all fee items, otherwise exact item name
  serviceIds   String                @default("*") // DAILY_SERVICE scope: "*" = all services, else csv of DailyService ids
  description  String?
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  rules        DiscountRule[]
  applications DiscountApplication[]

  @@unique([schoolId, name])
}

// Per-class / per-fee-item overrides inside a profile
model DiscountRule {
  id            String          @id @default(cuid())
  profileId     String
  profile       DiscountProfile @relation(fields: [profileId], references: [id])
  classroomName String? // null = all classes
  feeItemName   String? // null = profile default
  value         Int // percent or pesewas override
}

model DiscountApplication {
  id             String           @id @default(cuid())
  discountId     String?
  discount       Discount?        @relation(fields: [discountId], references: [id])
  profileId      String?
  profile        DiscountProfile? @relation(fields: [profileId], references: [id])
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id])
  serviceId      String? // for DAILY_SERVICE scope: which service gets the subsidised rate
  valueOverride  Int? // per-application override of the discount value
  status         String           @default("PENDING") // PENDING | APPROVED | REJECTED | REVOKED | EXPIRED
  validFrom      DateTime?
  validTo        DateTime?
  reason         String?
  appliedByName  String
  approvedByName String?
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())
}

// ─────────────────────────────────────────────────────────────
// EXPENDITURE (school expenses by category)
// ─────────────────────────────────────────────────────────────
model Expense {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  category       String // UTILITIES | SALARIES | MAINTENANCE | TRANSPORT_FUEL | TEACHING_MATERIALS | EVENTS | ADMIN | OTHER
  description    String
  amountCents    Int
  method         String   @default("CASH") // CASH | MOMO_MTN | MOMO_TELECEL | MOMO_AT | BANK | CHEQUE
  expenseDate    DateTime @default(now())
  recordedByName String?
  createdAt      DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// PURCHASE ORDERS (inventory restocking)
// ─────────────────────────────────────────────────────────────
model PurchaseOrder {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  poNo          String    @unique
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  linesJson     String    @default("[]") // [{itemId, name, qty, unitCostCents}]
  totalCents    Int       @default(0)
  status        String    @default("PENDING") // PENDING | RECEIVED | CANCELLED
  expectedDate  DateTime?
  receivedAt    DateTime?
  createdByName String?
  note          String?
  createdAt     DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// LIBRARY (librarian portal) — catalogue & circulation
// ─────────────────────────────────────────────────────────────
model LibraryBook {
  id        String        @id @default(cuid())
  schoolId  String
  school    School        @relation(fields: [schoolId], references: [id])
  title     String
  author    String?
  isbn      String?
  category  String        @default("General") // Storybook | Textbook | Reference | Fiction | Science | History ...
  copies    Int           @default(1)
  available Int           @default(1) // denormalised: copies − active loans
  shelf     String? // location e.g. "Shelf B-3"
  createdAt DateTime      @default(now())
  loans     LibraryLoan[]
  requests  BookRequest[]
}

model LibraryLoan {
  id              String      @id @default(cuid())
  bookId          String
  book            LibraryBook @relation(fields: [bookId], references: [id])
  studentId       String
  student         Student     @relation(fields: [studentId], references: [id])
  schoolId        String
  school          School      @relation(fields: [schoolId], references: [id])
  issuedAt        DateTime    @default(now())
  dueAt           DateTime
  returnedAt      DateTime?
  issuedByName    String?
  conditionNote   String? // condition on issue / return
  // ── wave 74: overdue chase & fines ──
  fineCents       Int         @default(0) // recorded when returned late (daysOverdue − grace × rate, capped); 0 = none
  finePostedAt    DateTime?   // when the fine rode onto the receipt/invoice engine (invoiceItem appended)
  overdueSmsAt    DateTime?   // last guardian reminder sent for THIS loan
  overdueSmsCount Int         @default(0)
}

// ─────────────────────────────────────────────────────────────
// OPS SETTINGS (key-value: statutory rates, numbering, etc.)
// ─────────────────────────────────────────────────────────────
model OpsSetting {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  key       String // e.g. SSNIT_TIER1_RATE
  value     String
  updatedAt DateTime @default(now())

  @@unique([schoolId, key])
}

// ─────────────────────────────────────────────────────────────
// BOARDING (iEduPro boarding_system parity — houses / dormitories / beds)
// ─────────────────────────────────────────────────────────────
model BoardingHouse {
  id              String      @id @default(cuid())
  schoolId        String
  school          School      @relation(fields: [schoolId], references: [id])
  name            String
  description     String?
  houseMasterId   String? // staff — house master / warden
  houseMaster     Staff?      @relation("HouseMaster", fields: [houseMasterId], references: [id])
  prefectId       String? // learner — house prefect
  prefect         Student?    @relation("HousePrefect", fields: [prefectId], references: [id])
  capacity        Int         @default(0)
  yearEstablished String?
  gpsCode         String?
  termlyFeeCents  Int         @default(0)
  status          String      @default("AVAILABLE") // AVAILABLE | ASSIGNED | MAINTENANCE
  dormitories     Dormitory[]
  createdAt       DateTime    @default(now())
}

model Dormitory {
  id          String        @id @default(cuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id])
  houseId     String
  house       BoardingHouse @relation(fields: [houseId], references: [id])
  name        String
  capacity    Int           @default(0)
  type        String? // Male | Female
  floor       String?
  description String?
  prefectId   String? // learner — dormitory prefect
  prefect     Student?      @relation("DormitoryPrefect", fields: [prefectId], references: [id])
  status      String        @default("AVAILABLE") // AVAILABLE | ASSIGNED | MAINTENANCE
  beds        Bed[]
  createdAt   DateTime      @default(now())
}

model Bed {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  dormitoryId String
  dormitory   Dormitory @relation(fields: [dormitoryId], references: [id])
  code        String // e.g. AGY-014
  bedType     String    @default("SINGLE") // SINGLE | BUNK
  status      String    @default("AVAILABLE") // AVAILABLE | ASSIGNED | MAINTENANCE
  studentId   String?   @unique // currently assigned boarder (one-to-one)
  student     Student?  @relation("BedOccupant", fields: [studentId], references: [id])
  assignedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([schoolId, code])
}

// ─────────────────────────────────────────────────────────────
// LIBRARY BOOK REQUESTS (student/parent portal → librarian queue)
// ─────────────────────────────────────────────────────────────
model BookRequest {
  id            String      @id @default(cuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id])
  bookId        String
  book          LibraryBook @relation(fields: [bookId], references: [id])
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  startAt       DateTime // requested issue date
  endAt         DateTime // requested return date
  status        String      @default("PENDING") // PENDING | ISSUED | REJECTED
  handledAt     DateTime?
  handledByName String?
  loanId        String? // the LibraryLoan created on accept
  createdAt     DateTime    @default(now())
}

// ─────────────────────────────────────────────────────────────
// QUESTION PAPER BANK (iEduPro question_paper parity)
// ─────────────────────────────────────────────────────────────
model QuestionPaper {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  title       String
  body        String // rich text (HTML) — the paper itself
  examName    String? // e.g. "End of Term 1 Examination 2026/27"
  authorName  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────
// RECEIPT / INVOICE MODIFICATION-APPROVAL QUEUE (iEduPro parity)
// cashiers request an edit/delete; super admin approves, rejects or revokes
// ─────────────────────────────────────────────────────────────
model ModificationRequest {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id])
  targetType      String // PAYMENT | INVOICE
  recordId        String
  recordCode      String // receipt no / invoice no
  requestType     String // EDIT | DELETE
  reason          String
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | REVOKED
  requestedById   String
  requestedByName String
  originalData    String? // JSON snapshot of the record at request time
  newData         String? // JSON of the proposed replacement (EDiT)
  handledById     String?
  handledByName   String?
  handledAt       DateTime?
  decisionNote    String?
  createdAt       DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// WAEC RAW-SCORE GRADING (BECE/WASSCE scale — editable per school)
// ─────────────────────────────────────────────────────────────
model RawScoreGrade {
  id                String  @id @default(cuid())
  schoolId          String
  school            School  @relation(fields: [schoolId], references: [id])
  name              String // remark word: EXCELLENT / VERY GOOD / CREDIT / PASS / FAIL
  gradePoint        String // A1 … F9 (or 1–9)
  gradePointNumeric Float   @default(0) // BECE aggregate weight
  markFrom          Float
  markUpto          Float
  comment           String?
  sortOrder         Int     @default(0)
}

// ─────────────────────────────────────────────────────────────
// WAEC CANDIDACY (wave 57 — BECE / WASSCE registration & mocks)
// Ghanaian schools register JHS3 / SHS3 cohorts with WAEC every year:
// an exam centre number, per-candidate index numbers, subject entries,
// registration fees billed onto term invoices, and mock exams that are
// graded on the school's RawScoreGrade bands (A1..F9) with best-6
// aggregate analysis — the run-up to BECE / WASSCE.
// ─────────────────────────────────────────────────────────────
model WaecCentre {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  examType     String // BECE | WASSCE | NOVDEC
  examYear     Int
  centreNumber String // WAEC-assigned centre number (digits)
  centreName   String
  regFeeCents  Int      @default(0) // registration fee billed per candidate
  status       String   @default("OPEN") // OPEN | CLOSED
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  candidacies  WaecCandidacy[]

  @@unique([schoolId, examType, examYear])
  @@index([schoolId])
}

model WaecCandidacy {
  id          String   @id @default(cuid())
  centreId    String
  centre      WaecCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  serialNo    Int // candidate serial within the centre (roll order)
  indexNumber String? // centre number + padded serial — WAEC index
  status      String   @default("REGISTERED") // REGISTERED | INDEXED | SUBMITTED | WITHDRAWN
  feeInvoiced Boolean  @default(false)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subjects    WaecSubjectEntry[]
  mocks       WaecMockResult[]

  @@unique([centreId, studentId])
  @@unique([centreId, serialNo])
  @@index([studentId])
}

model WaecSubjectEntry {
  id          String   @id @default(cuid())
  candidacyId String
  candidacy   WaecCandidacy @relation(fields: [candidacyId], references: [id], onDelete: Cascade)
  subjectName String // matches the school Subject name (joined for mocks)
  subjectCode String? // WAEC subject code (e.g. "101" Mathematics)
  isCore      Boolean  @default(false) // core subjects drive the aggregate
  sortOrder   Int      @default(0)

  @@unique([candidacyId, subjectName])
}

model WaecMockResult {
  id          String   @id @default(cuid())
  candidacyId String
  candidacy   WaecCandidacy @relation(fields: [candidacyId], references: [id], onDelete: Cascade)
  subjectName String // matches WaecSubjectEntry.subjectName
  mockNo      Int // 1 | 2 | 3
  objective   Float? // section A / objective paper score
  theory      Float? // section B / theory paper score
  practical   Float? // optional practical / oral component
  maxScore    Float    @default(100)
  total       Float?
  grade       String? // A1..F9 via the school's RawScoreGrade bands
  gradePoint  Float? // BECE aggregate weight (lower is better)

  @@unique([candidacyId, subjectName, mockNo])
}

// ─────────────────────────────────────────────────────────────
// NTC CPD & LICENSURE (wave 58 — Ghana National Teaching Council)
// Teaching staff hold a renewable NTC licence; renewal requires CPD
// points over the licence cycle, split across NTC's programme
// categories. The school keeps the register + verification trail.
// ─────────────────────────────────────────────────────────────
model CpdSetting {
  id                 String  @id @default(cuid())
  schoolId           String  @unique
  school             School  @relation(fields: [schoolId], references: [id])
  targetMandatory    Float   @default(20) // NTC mandatory programmes points per cycle
  targetRank         Float   @default(40) // rank-based programmes points per cycle
  targetRecommended  Float   @default(40) // recommended / school-based programmes points per cycle
  cycleYears         Int     @default(3) // licence cycle length (rolling window when no licence dates)
}

model CpdActivity {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id])
  staffId         String
  staff           Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  title           String // e.g. "GES National Standard-based Curriculum workshop"
  provider        String? // NTC-accredited provider (CoE, GNAT, NTC itself…)
  category        String    @default("RECOMMENDED") // MANDATORY | RANK | RECOMMENDED
  activityDate    DateTime
  points          Float     @default(0)
  hours           Float? // contact hours
  evidence        String? // certificate number / description of proof
  status          String    @default("LOGGED") // LOGGED | VERIFIED | REJECTED
  verifiedByName  String?
  verifiedAt      DateTime?
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([schoolId, activityDate])
  @@index([staffId])
}

// ─────────────────────────────────────────────────────────────
// GES EMIS ANNUAL RETURN (wave 58 — the school census)
// Every school files an EMIS-style data return each census year:
// enrolment by class & gender, staffing, facilities, attendance and
// finance. Filing snapshots the live figures so history is immutable.
// ─────────────────────────────────────────────────────────────
model EmisReturn {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  year        Int // census year (e.g. 2026 for the 2025/26 return)
  dataJson    String // computed snapshot at filing time
  filedByName String
  note        String?
  createdAt   DateTime @default(now())

  @@unique([schoolId, year])
  @@index([schoolId])
}

// ─────────────────────────────────────────────────────────────
// PORTFOLIO ASSESSMENT (GES weekly SBA — strand scores feed class score)
// ─────────────────────────────────────────────────────────────
model PortfolioEntry {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  classroomId String
  subjectId   String
  subjectName String
  week        String // ISO week "2026-W44"
  entryDate   DateTime // the school day (Mon–Fri)
  strandCode  String? // curriculum strand / sub-strand code e.g. "B4.1.2.1"
  score       Float    @default(0) // 0–10 daily strand score
  createdAt   DateTime @default(now())

  @@unique([studentId, subjectId, entryDate])
}

// ─────────────────────────────────────────────────────────────
// DAILY-FEE PER-CHARGE AUDIT LOG (iEduPro daily_fee_audit_log parity)
// ─────────────────────────────────────────────────────────────
model DailyFeeAudit {
  id                 String   @id @default(cuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id])
  actionType         String // CHARGE | CHARGE_REVERSAL | PAYMENT | PAYMENT_REVERSAL | TOPUP | ADJUSTMENT | RECONCILIATION
  serviceCode        String // FEEDING | BREAKFAST | CLASSES | WATER | TRANSPORT | MULTIPLE
  amountCents        Int      @default(0)
  balanceBeforeCents Int      @default(0)
  balanceAfterCents  Int      @default(0)
  arrearsBeforeCents Int      @default(0)
  arrearsAfterCents  Int      @default(0)
  performedByName    String
  performedByRole    String
  reference          String? // receipt no / charge id
  notes              String?
  createdAt          DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// CASHIER HANDOVER REPORTS (signed daily float handover)
// ─────────────────────────────────────────────────────────────
model HandoverReport {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  date         DateTime
  cashierId    String
  cashierName  String
  receiverId   String
  receiverName String
  totalCents   Int      @default(0)
  cashCents    Int      @default(0)
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// CURRICULUM & LESSON NOTES (iEduPro lesson-note lifecycle parity:
// templates → teacher weekly notes → HOD/admin review → endorse /
// request revision → progress & compliance; plus study material
// sharing and the week-by-week scheme of learning)
// ─────────────────────────────────────────────────────────────
model LessonNoteTemplate {
  id              String     @id @default(cuid())
  schoolId        String
  school          School     @relation(fields: [schoolId], references: [id])
  subjectId       String?
  subject         Subject?   @relation(fields: [subjectId], references: [id])
  classroomId     String? // null = any class studying the subject
  classroom       Classroom? @relation(fields: [classroomId], references: [id])
  name            String
  strand          String?
  subStrand       String?
  contentStandard String?
  description     String?
  objectives      String     @default("")
  activities      String     @default("")
