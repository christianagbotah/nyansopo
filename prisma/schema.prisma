  subStrandName     String?
  strandId          String? // CURRICULUM ALIGNMENT — framework strand/sub-strand/
  strand            CurriculumStrand?          @relation("NoteStrand", fields: [strandId], references: [id])
  subStrandId       String? // content standard + chosen indicators (GES SBC,
  subStrand         CurriculumSubStrand?       @relation("NoteSubStrand", fields: [subStrandId], references: [id])
  contentStandardId String? // Cambridge unit/objective, IB PYP theme — the
  contentStandard   CurriculumContentStandard? @relation("NoteStandard", fields: [contentStandardId], references: [id])
  indicatorIds      String? // JSON array of CurriculumIndicator ids
