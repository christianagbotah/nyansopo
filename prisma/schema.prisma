// Nyansapo — The Wisdom Knot That Binds Ghana's Schools
// Full data model for the Ghanaian private-school ecosystem:
// association hierarchy (GNACOPS-style), school groups & branches, students,
// cross-school transfer tracking, defaulter flags, fees, attendance,
// gradebook, report cards, AI insights.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ASSOCIATION HIERARCHY (National → Regional → District → Zone)
// ─────────────────────────────────────────────────────────────
model AssociationNode {
  id            String            @id @default(cuid())
  code          String            @unique
  name          String
  level         String // NATIONAL | REGIONAL | DISTRICT | ZONE
  region        String?
  meetingTown   String?
  leadTitle     String? // e.g. "National Executive Director"
  leadName      String?
  parentId      String?
  parent        AssociationNode?  @relation("NodeTree", fields: [parentId], references: [id])
  children      AssociationNode[] @relation("NodeTree")
  schools       School[]
  users         User[]
  announcements Announcement[]
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  password          String
  fullName          String
  phone             String?
  role              String // ASSOCIATION_* | GROUP_OWNER | SUPER_ADMIN | SCHOOL_ADMIN | ACCOUNTANT | CASHIER | BUS_CONDUCTOR | TEACHER | NON_TEACHING | LIBRARIAN | PARENT | STUDENT
  title             String? // display title e.g. "National Executive Director", "Headteacher"
  associationNodeId String?
  associationNode   AssociationNode? @relation(fields: [associationNodeId], references: [id])
  schoolGroupId     String?
  schoolGroup       SchoolGroup?     @relation(fields: [schoolGroupId], references: [id])
  schoolId          String?
  school            School?          @relation(fields: [schoolId], references: [id])
  avatarSeed        String?
  // ── RBAC (iEduPro admin-level parity) ──
  status            String           @default("ACTIVE") // ACTIVE | SUSPENDED
  permissionsJson   String? // JSON { extra: string[], denied: string[] } — overrides on top of role defaults
  lastLoginAt       DateTime?
  staffId           String? // link to Staff record — staff self-service portal (payslips, profile)
  staff             Staff?           @relation("UserStaff", fields: [staffId], references: [id])
  sentThreads       MessageThread[]  @relation("MsgSender")
  receivedThreads   MessageThread[]  @relation("MsgRecipient")
  studentId         String? // link to Student record — student portal (own record only)
  linkedStudentIds  String? // JSON array of student ids — parent portal (own children only)
  createdAt         DateTime         @default(now())
}

// ─────────────────────────────────────────────────────────────
// SCHOOL GROUPS (multi-branch proprietors) & SCHOOLS
// ─────────────────────────────────────────────────────────────
model SchoolGroup {
  id             String   @id @default(cuid())
  name           String
  proprietorName String
  contactPhone   String?
  contactEmail   String?
  schools        School[]
  users          User[]
}

// ── Role configuration (wave 10): the school tunes WHAT EACH ROLE MAY DO.
//    One row per (school, role). System roles (CASHIER, TEACHER…) override the
//    code defaults; `isCustom` rows are brand-new roles minted by the admin
//    (e.g. "Bursar Assistant", "Front Desk"). Absent/inactive row → the role
//    falls back to ROLE_DEFAULTS in src/lib/rbac.ts. iEduPro parity: CI3 had
//    four competing permission systems; this is the one canonical model. ──
model RoleConfig {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  role          String // "CASHIER" | custom slug e.g. "BURSAR_ASSISTANT"
  label         String // display: "Bursar Assistant"
  level         Int? // admin-ladder level for badges (null = non-ladder staff)
  permissions   String // JSON string[] — this role's permission set at this school
  isCustom      Boolean  @default(false) // custom roles are deletable; system rows are overrides
  active        Boolean  @default(true) // inactive = fall back to code defaults
  landingModule String? // where users of the role land after login (custom roles; default "dashboard")
  note          String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, role])
  @@index([schoolId])
}

