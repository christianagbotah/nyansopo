.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# uploads (source references)
/upload/
/db/
/download/
/tool-results/
/examples/
/mini-services/
/dev.log

# embedded PostgreSQL runtime — binaries tracked (bin/lib/share) so a recycled
# sandbox can restart the server; the data cluster is regenerable
# (initdb cluster + prisma db push + seed chain — see scripts/pg/README.md)
/scripts/pg/*
!/scripts/pg/start-postgres.sh
!/scripts/pg/README.md
!/scripts/pg/bin/
!/scripts/pg/lib/
!/scripts/pg/share/
!/scripts/pg/sockets/
/scripts/pg/data/
/scripts/pg/postgres.log
# generated prisma clients (sqlite reader for migrations)
/generated/
# legacy sqlite backup
/db/legacy-sqlite-backup.db
scripts/verify-out.txt

# embedded postgres runtime state
scripts/pg-data/
scripts/pg/sockets/
scripts/pg/postgres.log
